 부담으로 1,590억원 적자로 전환됐다고 밝혔다. 손해율은 87.3%로 4.7%p 올랐다.","title":"자동차보험이 적자로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001399"},"text":"위험손해율(보유보험료 기준)은 전년 대비 9.7%p 증가한 97.2%을 기록했습니다"}],"text":"장기보험의 위험손해율(보유보험료 기준)은 전년보다 9.7%p 올라 97.2%였다.","title":"장기보험 위험손해율이 크게 올랐다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001399"},"text":"시장 경쟁 격화, 보험금 상승 등, 대/내외 시장환경은 여전히 어려운 한 해였습니다"}],"text":"회사는 2025년이 저성장, 지정학적 갈등, 시장 경쟁 격화, 보험금 상승으로 어려운 한 해였다고 밝혔다.","title":"경쟁 격화와 보험금 상승"}],"key":{"annual":{"year":2025,"basis":"연결","rev":null,"op":26591,"net":20203,"margin":null,"rev_growth":null,"op_growth":0.4,"debt":353.0,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001399"},"quarter":{"period":"2026-09","kind":"잠정실적","rev":65096,"op":5774,"rev_yoy":13.6,"op_yoy":-13.0,"rev_qoq":0.7,"op_qoq":-34.8,"margin":8.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112800008"},"target":{"avg":730000,"days":180,"high":750000,"latest":"2026-11-20","low":700000,"n":3}}}