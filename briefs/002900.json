r.kr/dsaf001/main.do?rcpNo=20261113000170"},"value":"984억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000170"},"value":"+78.0%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000170"},"value":"768억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000170"},"value":"+125.2%"}],"text":"2026년 3분기 누적 영업이익은 984억원으로 전년 같은 기간보다 78.0% 늘었다. 누적 순이익은 768억원으로 125.2% 늘었다.","title":"2026년 3분기 누적 이익이 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"트랙터 부문에서 2025년 종합만족도 1위를 달성하였으며"}],"text":"회사는 북미기계딜러협회의 '딜러스 초이스 어워드' 트랙터 부문에서 2025년 종합만족도 1위를 했다고 밝혔다.","title":"북미에서 서비스 평가가 좋다"}],"ticker":"002900","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"미국 600,682,122 64.6% 442,834,430 56.1%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"현재 미국 시장에 집중되어 있는 수출 비중을 점진적으로 분산시키고"}],"note":"해석: 한 시장 비중이 크면 그 시장의 수요나 무역 환경 변화에 실적이 크게 흔들릴 수 있습니다.","text":"2025년 미국 매출 비중은 64.6%로 2024년 56.1%보다 커졌다. 회사도 미국에 집중된 수출 비중을 점차 분산하겠다고 밝혔다.","title":"매출이 미국에 크게 몰려 있다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"주요국의 고금리 기조와 농가 소득 둔화 등의 영향으로 수요 위축이 지속되었으며, 주요 시장인 북미 트랙터 시장 또한 전년 대비 약 9% 감소"}],"text":"회사는 2025년에 고금리와 농가 소득 둔화로 글로벌 농기계 수요 위축이 이어졌고, 북미 트랙터 시장도 전년보다 약 9% 줄었다고 밝혔다.","title":"농기계 시장 수요가 위축됐다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"부 채 총 계 430,965 429,734"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"자 본 총 계 421,401 406,834"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"[유동부채] 370,412 343,319 27,093 7.9%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"매입채무의 증가 665억원"}],"text":"2025년 말 부채총계는 430,965백만원으로 자본총계 421,401백만원보다 많다. 유동부채는 370,412백만원으로 7.9% 늘었고, 매입채무가 665억원 늘었다.","title":"부채가 자본보다 많고 유동부채가 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"담배필터 79,589 79,919 (330) -0.4%"}],"text":"담배필터 매출은 2025년 79,589백만원으로 전년 79,919백만원보다 0.4% 줄었다.","title":"필터부문 매출이 소폭 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"text":"러시아-우크라이나 전쟁과 이란과 미국 간 갈등 등 지정학적 리스크가 지속되면서 글로벌 경제 및 교역 환경의 변동성이 확대될 가능성이 있습니다"}],"text":"회사는 러시아-우크라이나 전쟁과 이란-미국 갈등 같은 지정학적 위험 때문에 글로벌 경제와 교역 환경의 변동성이 커질 수 있다고 밝혔다.","title":"지정학적 불확실성"}],"key":{"annual":{"year":2025,"basis":"연결","rev":9294,"op":641,"net":401,"margin":6.9,"rev_growth":17.8,"op_growth":298.5,"debt":102.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001226"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":2601,"op":358,"rev_yoy":16.0,"op_yoy":124.7,"margin":13.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000170"}}}