kr/dsaf001/main.do?rcpNo=20261116000494"},"value":"-47억원"},{"computed":false,"k":"f","label":"순이익 · 전년 동기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000494"},"value":"52억원"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000494"},"value":"134억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000494"},"value":"149억원"}],"note":"해석: 영업이익은 늘었는데 순이익이 적자가 된 만큼 영업 밖의 비용이나 손실이 컸을 수 있습니다. 이 브리프가 쓴 공시 발췌에는 그 원인 설명이 없습니다.","text":"2026년 3분기 순이익은 -47억원으로, 전년 같은 분기 52억원에서 적자로 돌아섰다. 3분기 누적 순이익도 134억원으로 전년 누적 149억원보다 줄었다.","title":"3분기에 순이익이 적자로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"합계 168,299 199,295 256,736"}],"text":"BA 부문 매출은 2025년 168,299백만원으로, 2024년 199,295백만원과 2023년 256,736백만원에서 계속 줄었다.","title":"2차전지(BA) 매출이 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"부채비율 161.3% 144.0% 17.3%"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"설비투자 확대에 따른 차입금 증가(606억원)"}],"text":"2025년 말 부채비율은 161.3%로 전년 144.0%보다 높아졌다. 회사는 설비투자 확대에 따른 차입금 증가(606억원)를 주요 원인으로 들었다.","title":"설비투자로 부채가 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"투자활동으로 인한 현금흐름 (52,136,008) (14,369,856)"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"북미지역 및 동남아지역 설비투자 확대에 따른 유형자산 증가(974억원)"}],"text":"2025년 투자활동 현금흐름은 (52,136,008)천원으로 2024년 (14,369,856)천원보다 유출이 커졌다. 회사는 북미·동남아 설비투자 확대로 유형자산이 974억원 늘었다고 밝혔다.","title":"투자 지출이 커졌다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"text":"유동비율 105.9% 102.1%"}],"note":"해석: 유동자산이 유동부채를 조금 웃도는 수준이어서 단기 지급 여력의 여유가 크다고 보기는 어렵습니다.","text":"2025년 말 유동비율은 105.9%로 전기말 102.1%보다 올랐다.","title":"유동비율 여유가 크지 않다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":9454,"op":277,"net":242,"margin":2.9,"rev_growth":7.2,"op_growth":4.6,"debt":161.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000805"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":2845,"op":109,"rev_yoy":30.3,"op_yoy":115.5,"margin":3.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000494"}}}