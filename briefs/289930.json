fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"value":"407억원"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"value":"6억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"value":"-49억원"}],"text":"2025년 매출은 407억원으로 전년보다 38.4% 늘었다. 영업이익은 6억원으로, 전년 -49억원에서 흑자로 돌아섰다. 회사는 천마(핵심부품국산화) 프로젝트 매출이 진행된 것을 이유로 들었다.","title":"2025년 매출이 늘고 영업이익이 흑자로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"국내에서는 당사가 최초 양산 국산화에 성공하여 해당 제품을 생산/판매하고 있습니다"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"국내에서는 당사가 유일하게 칩 제조 공정을 국산화, 내재화 하고 있으며"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"GaN 칩 공급을 미국과 일본의 소수 업체에 100% 의존하고 있으며"}],"note":"해석: '국내 유일·최초'는 회사 자신의 설명이며, 이번 증거로 따로 확인된 것은 아닙니다.","text":"회사는 국내 최초로 GaN RF 반도체 칩 양산 국산화에 성공했고, 국내에서 유일하게 칩 제조 공정을 내재화하고 있다고 밝혔다. 회사 설명에 따르면 GaN 칩 공급은 미국과 일본의 소수 업체에 크게 의존하고 있고, 이들 나라는 엄격한 수출통제를 하고 있다.","title":"국내에서 GaN RF 칩 양산을 국산화했다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"287.6% 165.6% 부채비율"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"영업활동으로 인한 현금흐름 794,315 (4,584,193)"}],"note":"유동자산이 늘어난 데에는 신주인수권부사채(BW) 발행으로 들어온 자금이 크게 작용했습니다.","text":"2025년 말 유동비율은 287.6%로 전년 165.6%보다 높아졌다. 영업활동 현금흐름은 794,315천원으로, 전년 -4,584,193천원에서 플러스로 돌아섰다.","title":"유동성이 좋아지고 영업현금흐름이 플러스로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"합 계 내수 36,978 28,674 13,836 수출 3,728 722 3,054"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"인도 시장의 경우 글로벌 1위 반도체 distributor인 W사, S사와 긴밀한 협업 체계를 구축하여"}],"text":"2025년 수출 매출은 3,728백만원으로 2024년 722백만원보다 늘었다. 회사는 인도 시장에서 글로벌 반도체 유통사들과 협업 체계를 구축했다고 밝혔다.","title":"수출이 늘었다"}],"ticker":"289930","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000684"},"value":"196억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000684"},"value":"-14.2%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000684"},"value":"-63억원"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000684"},"value":"-32.2%"}],"text":"2026년 3분기 누적 매출은 196억원으로 전년 같은 기간보다 14.2% 줄었다. 누적 영업이익은 -63억원이고 누적 영업이익률은 -32.2%다.","title":"2026년 들어 매출이 줄고 영업적자로 돌아섰다"},{"evidence":[{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"value":"1.5%"}],"text":"2025년 영업이익률은 1.5%로, 흑자로 돌아섰지만 이익 규모는 작았다.","title":"흑자전환했지만 이익률은 낮았다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000533"},"text":"115.4% 99.3%