idence":[{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"value":"397억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"value":"+0.3%"},{"computed":false,"k":"f","label":"매출 · 2023년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"value":"420억원"}],"text":"2025년 연결 매출은 397억원으로 0.3% 늘어나는 데 그쳤고, 2023년 420억원보다 적다.","title":"연간 매출이 정체돼 있다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001633"},"value":"-38억원"},{"computed":false,"k":"f","label":"순이익 · 전년 동기 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001633"},"value":"13억원"},{"computed":false,"k":"f","label":"영업이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001633"},"value":"6억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 해당 분기","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001633"},"value":"-38.3%"}],"note":"적자의 원인은 이 브리프가 참고한 공시 내용에 나와 있지 않습니다(해석).","text":"2026년 3분기 순이익은 -38억원으로, 전년 같은 분기 13억원에서 적자로 바뀌었다. 3분기 영업이익도 6억원으로 전년 같은 분기보다 38.3% 줄었다.","title":"2026년 3분기에는 순이익이 적자였다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"당기순이익은 4,461백만원으로 전기 대비 139.9% 증가"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"일부 부동산을 매각함에 따라 처분이익이 발생하였습니다"}],"note":"부동산 처분이익은 매년 반복되는 이익이 아닐 수 있습니다(해석).","text":"2025년 연결 순이익은 4,461백만원으로 139.9% 늘어 영업이익보다 컸다. 회사는 일부 부동산을 팔아 처분이익이 생겼다고 밝혔다.","title":"2025년 순이익에는 부동산 처분이익이 포함됐다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"워크웨어 3,572 9.4% 5,127 13.5%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"언더웨어 5,831 15.4% 6,027 15.9%"}],"text":"워크웨어 매출은 2025년 3,572백만원으로 2024년 5,127백만원보다 줄었고, 언더웨어 매출도 5,831백만원으로 2024년 6,027백만원보다 줄었다.","title":"워크웨어와 언더웨어 매출이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"인건비 및 외주가공비 등 생산 관련 직ㆍ간접비가 상승하면서 제조 관련 매출원가 비중이 증가하였습니다"}],"text":"회사는 인건비와 외주가공비 등 생산 관련 비용이 올라 제조 관련 매출원가 비중이 커졌다고 밝혔다.","title":"생산 원가가 오르고 있다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"국내 의류 시장은 내수 의존도가 높아 경제성장률과 유사한 흐름을 보이며"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"text":"패션 시장 전반의 성장세가 둔화되고 있습니다"}],"text":"회사는 국내 의류 시장이 내수 의존도가 높고 경기에 민감하며, 소비 심리 위축으로 패션 시장 성장세가 둔화되고 있다고 밝혔다.","title":"내수 의류 소비가 위축돼 있다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":397,"op":24,"net":45,"margin":6.1,"rev_growth":0.3,"op_growth":128.2,"debt":28.5,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001354"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":103,"op":6,"rev_yoy":7.3,"op_yoy":-38.3,"margin":6.0,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001633"}}}