01/main.do?rcpNo=20261113001029"},"value":"-11.3%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000775"},"value":"-3.5%"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"},"value":"-9.4%"}],"text":"3분기 영업이익률은 -11.3%로 2025년 연간 -3.5%보다 낮다. 누적 영업이익률은 -9.4%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"},"value":"323억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"},"value":"-23.9%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"},"value":"-16억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"},"value":"-16억원"}],"text":"3분기 누적 매출은 323억원으로 23.9% 줄었다. 누적 순이익은 -16억원으로 전년 같은 기간(-16억원)과 비슷했다.","title":"3분기 누적"}]},"name":"제노코","pack_built":"2026-11-28T04:48:24","sources":[{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000775"},{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001029"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000775"},"text":"유동비율(%) 331.4 162.1 부채비율(%) 69.3 154.4"},{"comput