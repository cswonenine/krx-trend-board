장의 불확실성, 후발 경쟁사의 약진이 가격 경쟁을 심화시키고, 미국의 고율 관세 정책이 시장 불확실성을 높이고 있다고 밝혔다.","title":"철강 가격, 건설장비 경기, 관세 위험"}],"key":{"annual":{"year":2025,"basis":"연결","rev":3828,"op":304,"net":251,"margin":8.0,"rev_growth":-0.5,"op_growth":19.2,"debt":20.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001465"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":1043,"op":72,"rev_yoy":9.2,"op_yoy":-10.1,"margin":6.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000504"}}}