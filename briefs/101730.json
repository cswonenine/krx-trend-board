.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"-45.3%"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"-46.0%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"-32.8%"}],"text":"3분기 영업이익률은 -45.3%, 누적 영업이익률은 -46.0%로 2025년 연간 -32.8%보다 낮다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"963억원"},{"computed":false,"k":"f","label":"매출 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"1,183억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"-18.6%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"-374억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"},"value":"-246억원"}],"text":"3분기 누적 매출은 963억원으로 전년 같은 기간 1,183억원보다 18.6% 줄었다. 누적 순이익은 -374억원으로 전년 같은 기간 -246억원보다 나빠졌다.","title":"3분기 누적"}]},"name":"위메이드맥스","pack_built":"2026-11-27T10:51:18","sources":[{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000664"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"매출액 1,488 750 738 98.5 매드엔진 연결 편입"}],"text":"2025년 연결 매출은 1,488억원으로 2024년 750억원보다 98.5% 늘었다. 회사는 매드엔진 연결 편입을 주요 원인으로 들었다.","title":"2025년 연결 매출이 98.5% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"합계 71,230 52,621 22,434 2,554 148,840"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"해외 8,588 12,088 21,709 1,924 44,310"}],"text":"2025년 연결 매출 148,840백만원 가운데 해외 매출은 44,310백만원이었다. 해외에서는 PC온라인 매출이 21,709백만원으로 가장 컸다.","title":"해외에서도 매출을 낸다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"등을 포함하여 10종 이상입니다"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"모바일, PC 및 콘솔 플랫폼을 대상으로 개발되고 있으며"}],"text":"회사는 기존 IP를 넓히고 새 IP를 확보하려고 신작을 10종 이상 개발하고 있다. 대상 플랫폼은 모바일, PC, 콘솔이다.","title":"신작 10종 이상을 개발 중이다"},{"evidence":[{"computed":false,"k":"f","label":"부채총계 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"1,030억원"},{"computed":false,"k":"f","label":"자본총계 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"4,625억원"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"22.3%"}],"note":"해석: 자본이 크게 늘어난 것은 2024년 주식교환 영향으로 보이며, 손실이 이어지면서 자본은 2024년보다 줄었습니다.","text":"2025년 말 부채는 1,030억원, 자본은 4,625억원이다. 부채/자본 비율은 22.3%다.","title":"부채 부담은 자본에 비해 크지 않다"}],"ticker":"101730","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"영업이익 (487) (81) (407) -502.2 개발인력 확충, PPA상각비 반영"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"-32.8%"}],"text":"2025년 영업손실은 487억원으로 2024년 81억원보다 커졌다. 영업이익률은 -32.8%였다. 회사는 개발인력 확충과 PPA상각비 반영을 원인으로 들었다.","title":"2025년 영업손실이 크게 커졌다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"Adjusted EBITDA (150) (29) (121) -412.3 비현금성 PPA, 상각비 제거 후 실질 손실"}],"text":"PPA 상각비 등을 다시 더한 Adjusted EBITDA도 2025년 -150억원으로 2024년 -29억원보다 나빠졌다. 회사는 이를 실질 손실이라고 설명했다.","title":"상각비를 빼도 손실이다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"text":"당기순이익 (358) (157) (201) -128.5 영업손실 확대"}],"text":"2025년 당기순손실은 358억원으로 2024년 157억원보다 커졌다. 회사는 영업손실 확대를 원인으로 들었다.","title":"순손실이 커졌다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"-242억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001649"},"value":"24억원"}],"text":"2025년 영업현금흐름은 -242억원으로 2024년 24억원에서 마이너스로 바뀌었다.","title":"영업현금흐름이 마이너스로 돌아섰다"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/ds