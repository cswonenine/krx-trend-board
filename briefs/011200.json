.fss.or.kr/dsaf001/main.do?rcpNo=20261112000381"},"value":"+51.8%"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001444"},"value":"1.9조원"}],"text":"1~9월 누적 순이익은 2.3조원으로 전년 같은 기간보다 51.8% 늘었다. 2025년 연간 순이익 1.9조원보다 많다.","title":"누적 순이익이 2025년 연간을 넘었다"}]},"name":"HMM","pack_built":"2026-11-12T16:26:50","sources":[{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001444"},{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000381"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001444"},"text":"연결재무제표 기준 매출 10조 8,914억원, 영업이익 1조 4,612억원, 부채비율 26.3%, 자기자본비율 79.2%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001444"},"text":"현금및현금성자산 1,760,767 1,471,825 288,942 19.6"}],"text":"2025년 말 연결 기준 부채비율은 26.3%, 자기자본비율은 79.2%다. 현금및현금성자산은 1,760,767백만원으로 전년 말보다 19.6% 늘었다.","title":"재무구조가 매우 튼튼하다"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000381"},"value":"4.1조원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 해당 분기","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000381"},"value":"+52.5%"},{"computed":false,"k":"f","label":"영업이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000381"},"value":"1.4조원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 해당 분기","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","