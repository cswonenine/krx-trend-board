fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"연결기준 매출액 1조 2,418억원, 영업이익 273억원"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"매출액 1,241,787 1,373,389 △131,602 △9.6"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"임대 외 기타 290,008,300 401,317,620"}],"note":"해석: 회사 설명이 없어 임대 외 기타 매출이 줄어든 이유는 확인되지 않습니다.","text":"2025년 연결 매출은 1조 2,418억원으로 전년보다 9.6% 줄었다. 사업부문 가운데 임대 외 기타 매출이 290,008,300천원으로 전년 401,317,620천원보다 크게 줄었다.","title":"2025년 연결 매출이 9.6% 줄었다"},{"evidence":[{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"value":"2.2%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"value":"1.8%"},{"computed":true,"k":"f","label":"영업이익률 · 2023년","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"value":"2.5%"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001405"},"value":"2.4%"}],"text":"2025년 연결 영업이익률은 2.2%로, 전년 1.8%보다는 올랐지만 2023년 2.5%보다는 낮다. 2026년 3분기 누적 영업이익률은 2.4%다.","title":"영업이익률이 낮다"},{"evidence":[{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"당기순이익 65,603 85,471 △19,868 △23.2"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"관계기업지분에 대한 손익 48,125 63,589 △15,464 △24.3"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"기타수익 5,054 17,811 △12,757 △71.6"}],"note":"해석: 관계기업 손익이 영업이익보다 커서, 순이익이 관계기업 실적에 크게 좌우되는 구조로 보입니다.","text":"2025년 연결 순이익은 65,603백만원으로 전년보다 23.2% 줄었다. 관계기업지분에 대한 손익이 48,125백만원으로 24.3% 줄었고, 기타수익도 71.6% 줄었다.","title":"2025년 순이익이 23.2% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"항만하역 172,623 22.9 181,926 23.5 195,350 26.6"}],"text":"별도 기준 항만하역 매출은 2023년 195,350백만원, 2024년 181,926백만원, 2025년 172,623백만원으로 해마다 줄었다. 매출 비중도 26.6%에서 22.9%로 낮아졌다.","title":"항만하역 매출이 해마다 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320001327"},"text":"지속되는 불안정한 국제 정세 및 물류업계 내 경쟁의 심화로 인한 어려운 경영환경"}],"text":"회사는 불안정한 국제 정세와 물류업계 내 경쟁 심화로 경영환경이 어렵다고 밝혔다.","title":"어려운 경영환경"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001405"},"value":"231억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001405"},"value":"-22.1%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001405"},"value":"329억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001405"},"value":"-42.2%"}],"text":"2026년 3분기 누적 영업이익은 231억원으로 전년 같은 기간보다 22.1% 줄었다. 누적 순이익은 329억원으로 42.2% 줄었다.","title":"2026년 3분기 누적 이익이 줄었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":12418,"op":273,"net":6