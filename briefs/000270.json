?rcpNo=20260312001224"},"text":"관세, 전기차 보조금 종료 및 환경규제 완화 등 변화하는 시장상황에 대응하여"}],"text":"회사는 미국에서 관세, 전기차 보조금 종료, 환경규제 완화 등 시장 상황 변화에 대응하고 있다고 밝혔다.","title":"미국 정책 변화에 노출돼 있다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":1141409,"op":90781,"net":75542,"margin":8.0,"rev_growth":6.2,"op_growth":-28.3,"debt":61.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001224"},"quarter":{"period":"2026-10","kind":"잠정실적","rev":null,"op":null,"rev_yoy":null,"op_yoy":null,"rev_qoq":null,"op_qoq":null,"margin":null,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261102800493"},"target":{"avg":139143,"days":180,"high":210000,"latest":"2026-11-25","low":29000,"n":7}}}