in.do?rcpNo=20260318000018"},"text":"PC/노트북은 전방 산업 둔화로 판매량이 감소하였으며"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000018"},"text":"범용 메모리테스트소켓 시장은 1분기까지 감소하다가"}],"text":"회사는 2025년 PC/노트북 소켓 판매량이 전방 산업 둔화로 감소했다고 밝혔다. 또 범용 메모리 테스트소켓 시장은 2026년 1분기까지 감소할 것으로 전망했다.","title":"PC·노트북 부문은 부진하고 메모리 소켓은 회복 전이었다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 해당 분기","src":{"date":"20261027","id":"S3","title":"연결재무제표기준영업(잠정)실적(공정공시)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027900052"},"value":"149억원"},{"computed":false,"k":"f","label":"순이익 · 전분기 대비","src":{"date":"20261027","id":"S3","title":"연결재무제표기준영업(잠정)실적(공정공시)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027900052"},"value":"-23.3%"},{"computed":false,"k":"f","label":"순이익 · 전년 동기 대비","src":{"date":"20261027","id":"S3","title":"연결재무제표기준영업(잠정)실적(공정공시)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027900052"},"value":"-8.2%"},{"computed":true,"k":"f","label":"영업 외 손익(세전이익-영업이익) · 해당 분기","src":{"date":"20261027","id":"S3","title":"연결재무제표기준영업(잠정)실적(공정공시)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027900052"},"value":"-14억원"}],"text":"2026년 3분기 순이익은 149억원으로 전분기보다 23.3%, 전년 동기보다 8.2% 줄었다. 영업이익은 늘었지만 영업 외 손익이 적자였다.","title":"3분기 순이익이 줄었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":2202,"op":601,"net":563,"margin":27.3,"rev_growth":26.2,"op_growth":34.1,"debt":15.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000018"},"quarter":{"period":"2026-09","kind":"잠정실적","rev":718,"op":218,"rev_yoy":11.2,"op_yoy":25.4,"rev_qoq":-1.6,"op_qoq":2.4,"margin":30.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027900052"},"target":{"avg":200000,"days":180,"high":210000,"latest":"2026-11-13","low":180000,"n":4}}}