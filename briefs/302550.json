812000883"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 ([첨부추가]반기보고서 (2026.06))","src":{"date":"20260812","id":"S2","title":"[첨부추가]반기보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260812000883"},"value":"145억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20260812","id":"S2","title":"[첨부추가]반기보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260812000883"},"value":"+21.2%"},{"computed":false,"k":"f","label":"영업이익 · 누적 ([첨부추가]반기보고서 (2026.06))","src":{"date":"20260812","id":"S2","title":"[첨부추가]반기보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260812000883"},"value":"16억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 ([첨부추가]반기보고서 (2026.06))","src":{"date":"20260812","id":"S2","title":"[첨부추가]반기보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260812000883"},"value":"4억원"}],"text":"2026년 상반기 누적 매출은 145억원으로 전년 같은 기간보다 21.2% 늘었다. 누적 영업이익은 16억원으로, 전년 같은 기간 4억원보다 늘었다.","title":"2026년 상반기 매출과 영업이익이 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"자기자본비율 73.2 68.2 - - - 부채비율 36.6 46.7"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"부채의 주요 감소 요인은 전환사채의 전환/상환 입니다"}],"text":"2025년 말 부채비율은 36.6%로 전년 46.7%보다 낮아졌다. 자기자본비율은 73.2%였다. 회사는 부채가 줄어든 주된 이유로 전환사채의 전환과 상환을 들었다.","title":"부채비율이 낮아졌다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"합계 3,913,193 3,035,968 2,862,096"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"BRAIN STIM 내수 2,099,555 1,032,433 331,136"}],"note":"같은 기간 ALTMS 수출은 줄었습니다. 따라서 뇌재활 매출 증가는 주로 국내 BrainStim 판매 덕분으로 보입니다(해석).","text":"뇌재활 부문 제품 매출은 2025년 3,913,193천원으로 2024년 3,035,968천원보다 늘었다. 특히 BrainStim 내수 매출이 2,099,555천원으로 전년 1,032,433천원보다 늘었다.","title":"뇌재활(TMS) 매출이 늘었다"}],"ticker":"302550","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"영업이익 725,838 1,121,188 (395,350) (35.3)"},{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"value":"245억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"value":"-4.1%"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"value":"7억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"value":"3.0%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"value":"4.4%"}],"text":"2025년 연결 매출은 245억원으로 4.1% 줄었다. 영업이익은 7억원으로 35.3% 줄었다. 영업이익률은 3.0%로 전년 4.4%보다 낮아졌다.","title":"2025년 매출과 영업이익이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"당기순이익 (35,469) 7,380,754"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"기타수익 607,067 6,133,922 (5,526,855) (90.1)"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"금융수익 862,957 2,882,095 (2,019,138) (70.1)"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"-지배기업의 소유주지분 손익 526,195 7,172,078"}],"note":"2024년 순이익은 영업 밖의 수익이 크게 반영된 결과로 보입니다. 따라서 2025년 적자 전환은 일회성 수익이 빠진 영향이 큰 것으로 보입니다(해석).","text":"2025년 연결 당기순이익은 35,469천원 손실이다. 2024년에는 7,380,754천원 이익이었다. 기타수익은 607,067천원으로 2024년 6,133,922천원보다 크게 줄었다. 금융수익도 2,882,095천원에서 862,957천원으로 줄었다. 다만 지배기업 소유주 몫 손익은 526,195천원 이익이었다.","title":"2025년 연결 순손실로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"합계 13,794,002 15,900,679 11,965,712"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"emField Pro 수출 3,344,312 4,370,300 3,404,280"}],"note":"회사는 만성통증 장비(PMS)를 캐시카우라고 부릅니다. 따라서 이 부문의 감소는 전체 실적에 부담이 된 것으로 보입니다(해석).","text":"만성통증치료 부문 매출은 2025년 13,794,002천원으로 2024년 15,900,679천원보다 줄었다. 이 가운데 emField Pro 수출은 3,344,312천원으로 전년 4,370,300천원보다 줄었다.","title":"주력인 만성통증치료 매출이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"환율 변동에 노출되어 있는 부분은 수출주도형 업체로서 감내해야 하는 부분이라 생각합니다"},{"k":"q","src":{"date":"20260317","id":"S1","title":"[첨부추가]사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"text":"각 당국의 허가를 취득해야 하는 절차가 존재함에 따라 시기의 완급 조절은 있을 수 있습니다"}],"text":"회사는 수출 주도형 업체로서 환율 변동에 노출되어 있다고 밝혔다. 또 해외와 국내 시장에 진출하려면 각 당국의 허가가 필요해 시기가 늦춰질 수 있다고 했다.","title":"환율과 인허가 일정에 영향을 받는다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":245,"op":7,"net":0,"margin":3.0,"rev_growth":-4.1,"op_growth":-35.3,"debt":36.6,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000860"},"quarter":{"period":"2026-06","kind":"[첨부추가]반기보고서","rev":74,"op":9,"rev_yoy":32.7,"op_yoy":3697.2,"margin":12.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260812000883"}}}