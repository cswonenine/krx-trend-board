1116001009"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001009"},"value":"4,807억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001009"},"value":"+6.8%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001009"},"value":"144억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001009"},"value":"+25.3%"}],"text":"2026년 3분기 누적 매출은 4,807억원으로 전년 같은 기간보다 6.8% 늘었다. 누적 영업이익은 144억원으로 25.3% 늘었다.","title":"2026년 3분기 누적 매출과 영업이익이 늘었다"},{"evidence":[{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"37.4%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"37.6%"}],"text":"2025년 말 부채/자본 비율은 37.4%로 전년 37.6%와 비슷한 수준이다.","title":"부채 부담이 크지 않다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"도료부문 계 수 출 32,845 30,371 24,422"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"합성수지부문 계 수 출 60,311 58,883 59,487"}],"text":"2025년 도료부문 수출은 32,845백만원으로 2024년 30,371백만원보다 늘었다. 합성수지부문 수출도 60,311백만원으로 2024년 58,883백만원보다 늘었다.","title":"수출 매출은 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"페놀 및 우레탄의 특정분야에서는 기술우위와 시장지배력을 기반으로 시장을 주도하고 있는 상황입니다"}],"note":"회사 자체의 평가이며 시장점유율 수치는 공시에 제시되지 않았습니다.","text":"회사는 합성수지 부문이 페놀과 우레탄의 특정 분야에서 기술우위와 시장지배력을 바탕으로 시장을 주도하고 있다고 설명했다.","title":"합성수지 일부 분야에서 시장을 주도한다고 밝혔다"}],"ticker":"000860","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"연결 기준으로 6.9% 감소한 5,986억원을 실현하였고"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"연결 기준 83억원의 이익을 실현하여 이익 금액이 전년 대비 59.6% 감소하였습니다"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"1.4%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"3.2%"}],"text":"2025년 연결 매출은 5,986억원으로 6.9% 줄었다. 연결 영업이익은 83억원으로 59.6% 줄었고, 영업이익률은 1.4%로 전년 3.2%보다 낮아졌다.","title":"2025년 매출과 영업이익이 모두 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"매출액은 별도 기준으로 전년 대비 12.8% 감소한 2,729억원"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"영업이익은 별도 기준 242억원의 손실을 실현하여 손실금액이 전년 대비 62.8% 증가하였으며"}],"text":"2025년 별도 기준 매출은 2,729억원으로 12.8% 줄었다. 별도 기준 영업손실은 242억원으로 손실 금액이 전년보다 62.8% 늘었다.","title":"별도 기준으로는 영업손실이 커졌다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"9억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"181억원"},{"computed":true,"k":"f","label":"순이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"value":"0.2%"}],"text":"2025년 연결 순이익은 9억원으로 2024년 181억원보다 크게 줄었다. 순이익률은 0.2%였다.","title":"2025년 순이익이 크게 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"도료부문 계 수 출 32,845 30,371 24,422 내 수 299,749 337,993 339,934"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"국내 경제 또한 건설 경기 회복 지연과 내수 부진이 지속되는 가운데"}],"text":"2025년 도료부문 내수 매출은 299,749백만원으로 2024년 337,993백만원보다 줄었다. 회사는 건설 경기 회복 지연과 내수 부진이 이어졌다고 밝혔다.","title":"도료 내수 매출이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"1. 현금및현금성자산 50,059 56,604 85,760 (11.6) (34.0)"}],"text":"2025년 말 현금및현금성자산은 50,059백만원으로 전년 56,604백만원보다 11.6% 줄었다.","title":"현금이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"원재료의 가격은 국제유가 및 환율의 등락에 따라 주로 변동되고 있습니다"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"text":"주요 생산업체들의 시장에서의 독점비율은 높은 편입니다"}],"text":"회사는 원재료 가격이 주로 국제유가와 환율에 따라 변한다고 밝혔다. 주요 원재료 생산업체들의 시장 독점비율도 높은 편이라고 설명했다.","title":"원재료 가격이 유가와 환율에 좌우된다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":5986,"op":83,"net":9,"margin":1.4,"rev_growth":-6.9,"op_growth":-59.6,"debt":37.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001400"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":1552,"op":12,"rev_yoy":5.3,"op_yoy":-72.3,"margin":0.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001009"}}}