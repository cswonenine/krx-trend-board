or.kr/dsaf001/main.do?rcpNo=20260320000571"},"value":"0.4%"}],"text":"2025년 순이익은 1,260억원으로 2024년 66억원에서 크게 늘었다. 순이익률은 6.6%로 전년 0.4%보다 높아졌다.","title":"2025년 순이익이 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000571"},"text":"당기순이익의 큰 폭 증가와 차입금 상환 등을 바탕으로 전년도 177.2%였던 연결기준 부채비율을 133.9%로 대폭 개선하였습니다"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000571"},"text":"현금및현금성자산 144,789,238,320 115,358,033,805"}],"text":"회사는 순이익 증가와 차입금 상환으로 연결 부채비율을 전년 177.2%에서 133.9%로 낮췄다고 밝혔다. 2025년 말 현금및현금성자산은 144,789,238,320원으로 전년 115,358,033,805원보다 늘었다.","title":"부채비율이 크게 낮아졌다"},{"evidence":[{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000571"},"text":"사료, 양돈, 식육 및 육가공으로 이어지는 수직계열화와 글로벌 시장 공략을 바탕으로"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000571"},"text":"내 수 1,023,878 892,271 1,061,563"},{"k":"q","src":{"date":"20260320","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260320000571"},"text":"내 수 301,570 262,343 250,139"}],"note":"해석: 여러 단계를 한 그룹 안에서 하기 때문에 한 단계의 가격 변화가 다른 단계에 영향을 줄 수 있습니다.","text":"회사는 사료, 양돈, 식육, 육가공으로 이어지는 수직계열화와 글로벌 시장 공략을 실적의 바탕으로 꼽았다. 2025년 사료부문 매출은 1,023,878백만원, 육가공부문 매출은 301,570백만원으로 모두 2024년보다 늘었다.","title":"사료에서 육가공까지 이어지는 수직계열화"}],"ticker":"136490","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000742"},"value":"82억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 동기 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=