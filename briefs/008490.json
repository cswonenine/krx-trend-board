r.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"9.1%"}],"text":"3분기 영업이익률은 5.8%로 2025년 연간 7.0%보다 낮다. 누적 영업이익률은 9.1%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"6,028억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"+8.4%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"547억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"+20.6%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"369억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"},"value":"-10.1%"}],"text":"3분기 누적 매출은 6,028억원으로 8.4% 늘었고 영업이익은 547억원으로 20.6% 늘었다. 누적 순이익은 369억원으로 10.1% 줄었다.","title":"3분기 누적"}]},"name":"서흥","pack_built":"2026-11-27T12:00:40","sources":[{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319001055"},{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000695"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319001055"},"text":"동 부문은 국내에서 독점적 지위를 확