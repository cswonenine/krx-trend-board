.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"-1.2%"}],"text":"3분기 영업이익률은 11.2%로 2025년 연간 18.6%보다 낮다. 누적 영업이익률은 -1.2%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"600억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"-25.5%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"4억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"108억원"}],"text":"3분기 누적 매출은 600억원으로 25.5% 줄었다. 누적 순이익은 4억원으로, 전년 같은 기간 108억원보다 줄었다.","title":"3분기 누적"}]},"name":"아나패스","pack_built":"2026-11-27T12:29:05","sources":[{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"스마트폰 OLED 패널용 TED 판매량 감소 등에 따라 매출액이 전년대비 40.6% 감소했으나, 고수익 제품 비중 확대에 따라 영업이익은 비슷한 수준을 유지하였습니다."},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"202억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"200억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"18.6%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"11.0%"}],"text":"2025년 매출은 40.6% 줄었다. 그래도 영업이익은 202억원으로 전년 200억원과 비슷했다. 영업이익률은 18.6%로 전년 11.0%보다 높아졌다. 회사는 고수익 제품 비중이 커진 것을 이유로 들었다.","title":"매출이 줄었지만 2025년 영업이익은 지켰다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"매출총이익률 36.6% 24.8% 43.2%"}],"text":"2025년 매출총이익률은 43.2%로 2024년 24.8%보다 높아졌다.","title":"매출총이익률이 크게 올랐다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"당기말 현재 당사는 682억원의 유동자금을 보유하고 있습니다."},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"부채비율은 전년대비 1.9%p 증가한 63.7%를, 자산총계 대비 차입금 비중을 나타내는 차입금 의존도는 6.1%를 기록하였습니다."}],"text":"2025년 말 회사가 보유한 유동자금은 682억원이다. 자산 대비 차입금 비중인 차입금 의존도는 6.1%다. 부채비율은 63.7%였다.","title":"차입금이 적고 유동자금이 있다"}],"ticker":"123860","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"스마트폰 OLED 패널용 TED 판매량 감소 등에 따라 매출액이 전년대비 40.6% 감소했으나"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"OLED향 T-Con/TED 98,595 91.15% 151,976 83.41%"},{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"1,082억원"}],"text":"2025년 매출은 1,082억원으로 40.6% 줄었다. 회사는 스마트폰 OLED 패널용 TED 판매량 감소를 이유로 들었다. OLED향 T-Con/TED 매출은 98,595백만원으로 2024년 151,976백만원보다 줄었다.","title":"2025년 매출이 40.6% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"기타비용 (2,247) (2,912) (24,085) 29.6% 727.0%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"영업외 기타비용이 증가함에 따라 당기순이익은 전년대비 85.6% 감소하였습니다."},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"value":"27억원"}],"note":"이번 증거에는 기타비용이 무엇이었는지에 대한 설명이 없습니다.","text":"2025년 기타비용은 24,085백만원으로 2024년 2,912백만원보다 크게 늘었다. 이 때문에 순이익은 27억원으로 85.6% 줄었다.","title":"기타비용이 늘어 2025년 순이익이 85.6% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"품목별 매출 비중은 OLED향 T-Con/TED 91.15%"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"text":"고객사 삼성디스플레이 등"}],"note":"해석: 특정 품목과 고객의 주문 변화가 실적에 크게 영향을 줄 수 있는 구조로 보입니다.","text":"2025년 매출의 91.15%가 OLED향 T-Con/TED에서 나왔다. 주요 매출처는 삼성디스플레이 등이다.","title":"한 품목과 소수 고객에 매출이 몰려 있다"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"-7억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"171억원"},{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"600억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"},"value":"-25.5%"}],"text":"2026년 3분기 누적 영업손익은 -7억원으로 적자다. 전년 같은 기간에는 171억원 이익이었다. 누적 매출은 600억원으로 25.5% 줄었다.","title":"2026년 3분기 누적으로 영업적자다"}],"key":{"annual":{"year":2025,"basis":"별도","rev":1082,"op":202,"net":27,"margin":18.6,"rev_growth":-40.6,"op_growth":0.5,"debt":63.7,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000908"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":266,"op":30,"rev_yoy":-18.1,"op_yoy":-68.6,"margin":11.2,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000481"}}}