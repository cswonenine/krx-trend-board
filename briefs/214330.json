":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"0.2%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001668"},"value":"1.6%"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"1.6%"}],"text":"3분기 영업이익률은 0.2%로 2025년 연간 1.6%보다 낮다. 3분기 누적 영업이익률은 1.6%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"2,710억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"-6.6%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"44억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"+3.9%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"-12억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000482"},"value":"-22억원"}],"text":"3분기 누적 매출은 2,710억원으로 6.6% 줄었지만 누적 영업이익은 44억원으로 3.9% 늘었다. 누적 순이익은 -12억원으로 전년 누적 -22억원보다 적자가 작다.","title":"3분기 누적"}]},"name":"금호에이치티","pack_built":"2026-11-25T16:41:36","sources":[{"d