main.do?rcpNo=20261112000293"},"value":"2,858억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000293"},"value":"+23.6%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000293"},"value":"305억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261112","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000293"},"value":"+129.9%"}],"text":"2026년 3분기 누적 매출은 2,858억원으로 전년 같은 기간보다 23.6% 늘었고, 누적 영업이익은 305억원으로 129.9% 늘었다.","title":"2026년 들어 실적이 크게 좋아졌다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"영업이익은 180억 원, 당기순이익은 180억 원을 기록하여 전기 대비 각각 7.1% 감소, 10.3% 증가하였습니다"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"당기순이익(*) 18,019 16,340 1,679 10.28 (*)지배기업 소유주지분에"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"212억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"199억원"}],"note":"해석: 영업이익은 줄었는데 순이익이 늘어난 것은 영업 외 항목의 영향으로 보이지만, 이번 증거에는 그 이유에 대한 회사 설명이 없습니다.","text":"회사 설명에 따르면 2025년 당기순이익(지배기업 소유주지분)은 180억 원으로 10.3% 늘었다. 비지배지분을 포함한 순이익은 212억원으로 2024년 199억원보다 많다.","title":"2025년 순이익은 늘었다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"241억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"206억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"배당금의 지급 3,170백만원"}],"text":"2025년 영업현금흐름은 241억원으로 2024년 206억원보다 늘었다. 같은 해 배당금으로 3,170백만원을 지급했다.","title":"영업현금흐름이 늘었고 배당을 지급했다"}],"ticker":"032560","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"2025년 연결기준 매출액은 전기 대비 1.4% 감소한 3,165억 원을 기록하였습니다. 영업이익은 180억 원, 당기순이익은 180억 원을 기록하여 전기 대비 각각 7.1% 감소, 10.3% 증가하였습니다"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"5.7%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"6.0%"}],"text":"2025년 연결 매출은 3,165억 원으로 1.4% 줄었고, 영업이익은 180억 원으로 7.1% 줄었다. 영업이익률은 5.7%로 전년 6.0%보다 낮아졌다.","title":"2025년 매출과 영업이익이 줄었다"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 2023년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"3,551억원"},{"computed":false,"k":"f","label":"매출 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"3,211억원"},{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"value":"3,165억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"내 수 170,379 181,432 192,783"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"스테인레스 외 3,644 3,738 3,991"}],"text":"연결 매출은 2023년 3,551억원, 2024년 3,211억원, 2025년 3,165억원으로 줄었다. 철강 제품 내수 매출도 192,783백만원에서 181,432백만원, 170,379백만원으로 줄었고, 스테인레스 외 제품 가격은 kg당 3,991원에서 3,738원, 3,644원으로 낮아졌다.","title":"연간 매출이 몇 년째 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"해외에서 원자재를 수입해야 하는 당사의 사업 특성상, 환율 변동은 원가 구조와 수익성에 즉각적인 영향을 주었습니다"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"원자재 가격은 하락했음에도 불구하고 급격한 환율 상승으로 인해 실질적인 조달 비용 절감 효과를 충분히 누리지 못했습니다"}],"text":"회사는 원자재를 수입하는 사업 특성상 환율 변동이 원가와 수익성에 바로 영향을 준다고 밝혔다. 2025년에는 원자재 가격이 내렸지만 환율이 크게 올라 조달 비용 절감 효과를 충분히 누리지 못했다고 설명했다.","title":"환율 변동에 따른 원가 부담"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"판매관리비 28,156 26,923 1,233 4.58"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"매출액 316,529 321,091 (4,562) -1.42"}],"text":"2025년 판매관리비는 28,156백만원으로 전년 26,923백만원보다 4.58% 늘어, 매출이 줄어든 가운데 비용 부담이 커졌다.","title":"판매관리비가 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"text":"자산의 주요 증가 원인은 재고자산의 증가 19,472백만원입니다"}],"note":"해석: 재고가 늘면 가격이 떨어질 때 부담이 될 수 있습니다. 같은 해 선수금도 늘어 수주 증가와 관련됐을 가능성이 있으나 공시에서 확인되지는 않습니다.","text":"2025년 자산 증가의 주된 원인은 재고자산 증가 19,472백만원이었다.","title":"재고자산이 늘었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":3165,"op":180,"net":212,"margin":5.7,"rev_growth":-1.4,"op_growth":-7.1,"debt":26.5,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000918"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":941,"op":93,"rev_yoy":18.4,"op_yoy":131.7,"margin":9.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261112000293"}}}