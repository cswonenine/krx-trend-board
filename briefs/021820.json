r.kr/dsaf001/main.do?rcpNo=20261116001856"},"value":"-7억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 동기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001856"},"value":"2억원"}],"text":"2026년 7~9월 분기 매출은 384억원으로 전년 같은 분기보다 21.8% 줄었고, 영업손익은 7억원 적자로 돌아섰다(전년 같은 분기 2억원 이익).","title":"최근 분기에 영업손실을 냈다"},{"evidence":[{"computed":true,"k":"f","label":"매출 증가율 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"-0.8%"},{"k":"q","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"text":"중국 내수 84,370 87,883 75,552"}],"text":"2026 회계연도 연결 매출은 0.8% 줄었다. 중국 지역 매출은 84,370백만원으로 전년 87,883백만원보다 줄었다.","title":"연간 매출이 소폭 줄었고 중국 매출이 감소했다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"348억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"604억원"},{"computed":false,"k":"f","label":"유형자산 취득 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"151억원"}],"text":"2026 회계연도 영업현금흐름은 348억원으로 전년 604억원보다 줄었다. 같은 기간 설비투자는 151억원이었다.","title":"영업현금흐름이 줄었다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"553억원"},{"computed":false,"k":"f","label":"영업이익 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"236억원"},{"computed":true,"k":"f","label":"순이익률 · 2026년","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"value":"31.1%"}],"note":"해석: 이익의 상당 부분이 영업 외 항목에서 나온 것으로 보이지만, 이번 증거에는 그 내역이 없어 출처와 지속성은 확인되지 않습니다.","text":"2026 회계연도 순이익은 553억원으로 영업이익 236억원보다 크고, 순이익률은 31.1%였다.","title":"순이익이 영업이익보다 훨씬 크다"},{"evidence":[{"k":"q","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"text":"자동차 부품 산업은 완성차 업체의 생산 및 판매 실적에 직접적인 영향을 받는 구조이며"},{"k":"q","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"text":"철강 등 주요 원재료 가격의 변동은 제조 원가에 영향을 줍니다"},{"k":"q","src":{"date":"20260922","id":"S1","title":"사업보고서 (2026.06)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"text":"환율(원/달러 등) 변동은 당사와 종속회사의 매출 및 수익성에 직, 간접적인 영향을 미칠 수 있습니다"}],"text":"회사는 자동차 부품 산업이 완성차 업체의 생산·판매 실적에 직접 영향을 받는 구조이고, 철강 등 원재료 가격과 환율 변동이 원가와 수익성에 영향을 줄 수 있다고 밝혔다.","title":"완성차 업황과 원자재·환율에 영향을 받는다"}],"key":{"annual":{"year":2026,"basis":"연결","rev":1780,"op":236,"net":553,"margin":13.3,"rev_growth":-0.8,"op_growth":38.7,"debt":9.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260922000499"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":384,"op":-7,"rev_yoy":-21.8,"op_yoy":"적자전환","margin":-1.7,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001856"}}}