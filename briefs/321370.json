ss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-106.0%"}],"text":"3분기 영업이익률은 -86.4%로 2025년 연간 -60.8%보다 낮다. 3분기 누적 영업이익률은 -106.0%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"77억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-40.9%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-82억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-102억원"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-101억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"},"value":"-120억원"}],"text":"3분기 누적 매출은 77억원으로 40.9% 줄었다. 누적 영업이익은 -82억원(전년 -102억원), 누적 순이익은 -101억원(전년 -120억원)이었다.","title":"3분기 누적"}]},"name":"센서뷰","pack_built":"2026-11-18T16:36:17","sources":[{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001214"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"190억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"+21.9%"},{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"방산 사업의 계약 및 수주 확대에 따른 제품 및 용역 매출 증가, 신규 고객사 확보 및 기존 고객사의 발주 확대, 공급 물량 확대에 따른 매출 실적 증가에 따라 전년 대비 매출 실적이 34억원이 증가하였습니다"}],"text":"2025년 연결 매출은 190억원으로 전년보다 21.9% 늘었다. 회사는 방산 사업의 계약·수주 확대, 신규 고객사 확보와 기존 고객사의 발주 확대를 이유로 들었다.","title":"2025년 매출이 21.9% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"필터, 안테나 등 4,885,869 25.69% 2,558,290 16.40%"},{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"수 출 1,258,509 236,390"}],"note":"해석: 회사는 국방 부품 국산화 수요가 늘 것으로 기대한다고 밝혔으며, 방산 매출 증가는 이 흐름과 맞닿아 있는 것으로 보입니다.","text":"국방·항공·우주 부문 매출은 2025년 4,885,869천원으로 2024년 2,558,290천원보다 늘었고, 비중도 16.40%에서 25.69%로 높아졌다. 이 부문 수출도 2024년 236,390천원에서 2025년 1,258,509천원으로 늘었다.","title":"국방·항공·우주 매출이 커졌다"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-116억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-158억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-60.8%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-101.2%"},{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"방산 분야 국산화 품목의 본격적인 양산 공급 및 신규 수주 확대로"}],"text":"2025년 영업이익은 -116억원(손실)으로 2024년 -158억원보다 손실이 줄었고, 영업이익률은 -101.2%에서 -60.8%로 나아졌다. 회사는 방산 국산화 품목의 양산 공급과 신규 수주 확대를 이유로 들었다.","title":"영업손실 폭이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"특히 39GHz 대역의 스몰셀에 적용되는 유일한 공급업체(Sole vendor)로 선정되었습니다"}],"text":"회사는 Qualcomm의 RF칩과 Digital칩을 연결하는 M-GROUP 부품이 39GHz 대역 스몰셀에 적용되는 유일한 공급업체(Sole vendor)로 선정됐다고 밝혔다.","title":"39GHz 스몰셀용 부품의 유일한 공급업체"}],"ticker":"321370","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-116억원"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"value":"-152억원"},{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"이익잉여금 (97,737,841,157)"}],"text":"2025년 영업이익은 -116억원, 순이익은 -152억원으로 손실이 이어졌다. 2025년 말 이익잉여금은 (97,737,841,157)원으로 결손이 쌓여 있다.","title":"영업손실과 순손실이 계속되고 있다"},{"evidence":[{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"유동자산 6,374,708,173"},{"k":"q","src":{"date":"20260311","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260311004387"},"text":"유동부채 19,672,602,192"},{"computed":false,"k":"f","label":"자본총계 · 2025년","src":{"date":"20260311","id":"S1","title":"사업보고