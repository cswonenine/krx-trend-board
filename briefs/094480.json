01/main.do?rcpNo=20260323001081"},"value":"14.2%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"10.3%"}],"text":"2025년 연결 영업이익은 184억원으로 전년보다 39.1% 늘었다. 영업이익률은 14.2%로 전년 10.3%보다 높아졌다.","title":"영업이익이 39.1% 늘고 이익률이 높아졌다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"82억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"6억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"ROE(자기자본이익률)는 약 6.9%를 기록하며"}],"text":"2025년 연결 순이익은 82억원으로 2024년 6억원보다 크게 늘었다. 회사는 2025년 연결 ROE를 약 6.9%로 밝혔다.","title":"순이익이 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"O2O사업 32,744 25.2 24,702 19.2"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"머니트리 사업이 O2O사업부문으로 이관되었습니다"}],"note":"해석: 2025년 조직개편으로 머니트리 사업이 O2O사업부문으로 옮겨졌기 때문에, 증가분 중 일부는 부문 재분류의 영향일 수 있습니다.","text":"O2O사업 매출은 2025년 32,744백만원으로 2024년 24,702백만원보다 늘었다. 매출 비중도 19.2%에서 25.2%로 높아졌다.","title":"O2O사업 매출이 늘었다"}],"ticker":"094480","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"매출액 129,700 128,772 928 0.7"},{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"1,297억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"+0.7%"},{"computed":true,"k":"f","label":"매출 증가율 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"-2.7%"}],"text":"2025년 연결 매출은 1,297억원으로 0.7% 늘어나는 데 그쳤다. 2024년에는 2.7% 줄었다.","title":"매출이 제자리걸음이다"},{"evidence":[{"computed":false,"k":"f","label":"부채총계 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"2,805억원"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"236.9%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"225.2%"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"신규 사업을 위한 단기차입금 증가에 따른 것입니다"}],"note":"해석: 결제대행업은 거래대금이 재무제표에 함께 잡히는 구조여서, 부채 규모를 일반 제조업과 같은 잣대로 보기는 어렵습니다.","text":"2025년 말 부채는 2,805억원이다. 자본 대비 부채 비율은 236.9%로 전년 225.2%보다 높아졌다. 회사는 부채가 늘어난 이유로 신규 사업을 위한 단기차입금 증가를 들었다.","title":"부채가 자본보다 훨씬 많다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"-15억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"value":"-266억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"선급금 213,722 184,598 29,124 15.8"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"서비스 거래대금 증가에 따른 선급금의 증가가 주요 요인입니다"}],"note":"해석: 선급금처럼 거래대금으로 묶이는 돈이 늘면서 영업현금흐름이 이익보다 약하게 나온 것으로 보입니다.","text":"영업현금흐름은 2025년 -15억원, 2024년 -266억원이었다. 2025년 말 선급금은 213,722백만원으로 15.8% 늘었다. 회사는 선급금 증가가 서비스 거래대금 증가 때문이라고 설명했다.","title":"영업현금흐름이 2년 연속 마이너스다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"대손상각비 8,918 5,743 -3,175 55.3"}],"text":"2025년 대손상각비는 8,918백만원으로 전년 5,743백만원보다 55.3% 늘었다.","title":"대손상각비가 55.3% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"text":"결제 수수료 환경 변화 등 대내외적 불확실성이 가중된 한 해였습니다"}],"text":"회사는 2025년을 결제 수수료 환경 변화 등으로 대내외 불확실성이 커진 해로 평가했다.","title":"소비 위축과 수수료 환경 변화"}],"key":{"annual":{"year":2025,"basis":"연결","rev":1297,"op":184,"net":82,"margin":14.2,"rev_growth":0.7,"op_growth":39.1,"debt":236.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001081"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":360,"op":48,"rev_yoy":9.5,"op_yoy":-1.1,"margin":13.2,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000695"}}}