다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001148"},"text":"당사에서 영위하는 사업 모두 소비자의 심리와 밀접하게 연관되어 있으며, 경기변동을 비롯한 휴가시즌/연말연시/명절/특수 기념일 등의 소비 행태에 영향을 받습니다"}],"text":"회사는 모든 사업이 소비자 심리와 밀접하고 경기변동과 명절·연말연시 등 소비 행태에 영향을 받는다고 밝혔다.","title":"소비 심리와 경기에 연동된다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":10947,"op":553,"net":452,"margin":5.1,"rev_growth":12.3,"op_growth":38.7,"debt":173.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001148"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":3998,"op":230,"rev_yoy":39.6,"op_yoy":29.3,"margin":5.7,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001242"},"consensus":{"period":"2026.3Q","rev_s":0.0304,"op_s":-0.065,"small":false,"date":"2026-11-16","prelim":false},"target":{"avg":10000,"days":180,"high":10000,"latest":"2026-11-17","low":10000,"n":1}}}