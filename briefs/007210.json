:"2025년 매출과 영업이익이 함께 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"text":"합 계 404,334 441,634 443,623"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"text":"국 내 216,306 235,360 244,670"}],"text":"건재부문 매출은 2025년 404,334백만원으로 2024년 441,634백만원보다 줄었다. 이 가운데 단열재 국내 매출은 216,306백만원으로 2024년 235,360백만원보다 줄었다.","title":"주력인 건재부문 매출이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"text":"전방 산업의 수요 둔화와 원가 부담 증가의 영향으로 영업이익률은 전기 4.0%에서 2.7%로 하락 하였으며"}],"text":"회사는 건재부문 설명에서 수요 둔화와 원가 부담 증가로 영업이익률이 4.0%에서 2.7%로 하락했다고 밝혔다.","title":"건재부문 수익성이 낮아졌다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"text":"국내 건설 및 부동산 시장은 고금리 기조와 공사비 상승에 따른 민간 발주 및 분양 시장의 위축으로 장기 침체가 지속되고 있습니다"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"text":"단기간 내 경기 회복을 낙관하기는 어려운 상황입니다"}],"text":"회사는 국내 건설·부동산 시장이 고금리와 공사비 상승으로 장기 침체가 이어지고 있으며, 단기간 내 경기 회복을 낙관하기 어렵다고 밝혔다.","title":"건설 경기 침체에 크게 영향을 받는다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"value":"364억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"value":"546억원"},{"computed":false,"k":"f","label":"유형자산 취득 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"value":"247억원"}],"text":"2025년 영업현금흐름은 364억원으로 2024년 546억원보다 줄었다. 같은 해 설비투자는 247억원이었다.","title":"영업현금흐름이 줄었다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001330"},"value":"98억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001330"},"value":"245억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001330"},"value":"-60.0%"}],"text":"2026년 3분기 누적 순이익은 98억원으로 전년 같은 기간 245억원보다 60.0% 줄었다.","title":"2026년 3분기 누적 순이익이 60.0% 줄었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":6107,"op":233,"net":274,"margin":3.8,"rev_growth":-5.0,"op_growth":-9.5,"debt":76.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001448"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":1392,"op":6,"rev_yoy":-12.4,"op_yoy":-91.6,"margin":0.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001330"}}}