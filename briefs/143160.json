ss.or.kr/dsaf001/main.do?rcpNo=20260318001553"},"text":"영업활동으로 인한 현금흐름 34,768 43,575 △8,808 -20.21%"}],"text":"2025년 영업활동으로 인한 현금흐름은 34,768백만원으로 전년 43,575백만원보다 20.21% 줄었다. 영업이익은 늘었지만 현금 유입은 줄었다.","title":"2025년 영업현금흐름이 줄었다"},{"evidence":[{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553"},"value":"6.5%"},{"computed":true,"k":"f","label":"영업이익률 · 2023년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553"},"value":"8.1%"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553"},"value":"233억원"},{"computed":false,"k":"f","label":"순이익 · 2023년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318001553"},"value":"253억원"}],"text":"2025년 영업이익률은 6.5%로 2023년 8.1%보다 낮고, 순이익 233억원도 2023년 253억원보다 적다.","title":"이익률이 2023년보다 낮다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000258"},"value":"25억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000258"},"value":"-63.7%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000258"},"value":"143억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000258"},"value":"-6.7%"}],"text":"2026년 3분기 순이익은 25억원으로 전년 같은 분기보다