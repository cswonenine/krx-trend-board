dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"2,203억원"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"144억원"}],"text":"2025년 연결 매출은 2,203억원으로 24.5% 늘었고 영업이익은 144억원으로 18.7% 늘었다. 회사는 토니모리와 메가코스의 화장품 매출 성장을 이유로 들었다.","title":"2025년 연결 매출이 24.5% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"신채널 28,855 13.10 11,763 6.65"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"올리브영, 다이소 등 주요 유통 채널을 중심으로 제품 입점 확대 및 판매 채널 다변화를 추진하고"}],"text":"PX, H&B, 다이소 등 신채널 매출은 2025년 28,855백만원(비중 13.10%)으로 2024년 11,763백만원(6.65%)보다 늘었다. 회사는 올리브영, 다이소 등에 입점을 늘리고 판매 채널을 넓혔다고 밝혔다.","title":"다이소·올리브영 등 신채널 매출이 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"제조업 국내 B2B 69,872 31.72 43,939 24.83"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"색 조 36,409 84% 20,506 68%"}],"text":"국내 B2B 제조 매출은 2025년 69,872백만원(31.72%)으로 2024년 43,939백만원(24.83%)보다 늘었다. 메가코스의 색조 제품 가동률은 84%로 전년 68%보다 높아졌다.","title":"OEM/ODM 제조 매출과 공장 가동률이 올랐다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"수 출 49,494 40,733 36,129"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"멕시코와 인도, 호주 등 신흥 시장으로의 확장 전략을 추진하여"}],"text":"제품·상품 수출 매출은 2025년 49,494백만원으로 2024년 40,733백만원보다 늘었다. 회사는 미국, 홍콩 외에 멕시코, 인도, 호주 등 신흥 시장으로 넓히고 있다고 밝혔다.","title":"수출이 늘고 진출 지역이 넓어지고 있다"}],"ticker":"214420","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000560"},"value":"96억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000560"},"value":"-29.5%"},{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000560"},"value":"1,621억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000560"},"value":"-3.3%"}],"text":"2026년 3분기 누적 영업이익은 96억원으로 전년 같은 기간보다 29.5% 줄었다. 누적 매출도 1,621억원으로 3.3% 줄었다.","title":"2026년 3분기 누적 영업이익이 29.5% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"매출원가 126,831 89,567 37,265 41.6%"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"㈜메가코스의 매출 비중 증가에 따라"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"+24.5%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"6.5%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"6.8%"}],"note":"회사는 이를 '원가율 41.6%p 상승'이라고 적었지만, 표의 41.6%는 매출원가 금액의 증가율입니다.","text":"2025년 매출원가는 126,831백만원으로 41.6% 늘어, 매출 증가율 24.5%보다 컸다. 영업이익률은 6.5%로 전년 6.8%보다 낮아졌다. 회사는 원가가 높은 메가코스의 매출 비중이 커진 것을 이유로 들었다.","title":"매출원가가 매출보다 빨리 늘어 이익률이 낮아졌다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"114억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"value":"166억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"당기순이익은 전년도 종속회사 ㈜메가코스의 이연법인세자산 인식에 따른 기저효과로 전년 대비 감소하였습니다"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"연결대상 투자조합이 보유한 공정가치측정 금융자산에 대한 평가손실이 일부 반영되었습니다"}],"text":"2025년 순이익은 114억원으로 2024년 166억원보다 줄었다. 회사는 2024년 메가코스의 이연법인세자산 인식에 따른 기저효과를 이유로 들었고, 투자조합이 보유한 금융자산의 평가손실도 일부 반영됐다고 밝혔다.","title":"2025년 순이익이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"부채비율 (A/B) 81.07% 80.39% 순차입금비율 (D-C)/B 30.40% 24.80%"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"유동부채 82,516 54,479 28,037 51.5%"}],"text":"2025년 말 부채비율은 81.07%, 순차입금비율은 30.40%로 전년 80.39%, 24.80%보다 높아졌다. 유동부채는 82,516백만원으로 51.5% 늘었다.","title":"차입 부담과 단기 부채가 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"직영점 및 가맹점 8,813 4.00 12,463 7.04"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"유통매장 17,721 8.04 22,045 12.46"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"온라인 22,032 10.00 24,306 13.73"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"text":"반려동물 간식 외 5,976 2.71 8,238 4.7"}],"text":"2025년 직영점·가맹점 매출은 8,813백만원(전년 12,463백만원), 유통매장은 17,721백만원(전년 22,045백만원), 온라인은 22,032백만원(전년 24,306백만원)으로 줄었다. 반려동물 간식 등 매출도 5,976백만원으로 전년 8,238백만원보다 줄었다.","title":"기존 매장·온라인 채널과 반려동물 매출은 줄었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":2203,"op":144,"net":114,"margin":6.5,"rev_growth":24.5,"op_growth":18.7,"debt":81.1,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323001192"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":562,"op":31,"rev_yoy":-0.2,"op_yoy":-27.8,"margin":5.6,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000560"},"consensus":{"period":"2026.3Q","rev_s":-0.0106,"op_s":0.3478,"small":false,"date":"2026-11-16","prelim":false}}}