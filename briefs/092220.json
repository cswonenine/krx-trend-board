.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"2,296억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"-5.6%"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"-218억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"-133억원"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"-266억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"value":"-9.5%"}],"text":"2025년 연결 매출은 2,296억원으로 5.6% 줄었다. 영업이익은 -218억원으로 2024년 -133억원보다 적자가 커졌고, 순이익은 -266억원이었다. 영업이익률은 -9.5%였다.","title":"2025년 매출이 줄고 적자가 커졌다"},{"evidence":[{"k":"q","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"text":"전방 산업의 수요 회복 지연에 따라 매출 확보가 부족했고, 이로 인해 고정비 부담을 극복하지 못한 결과입니다"}],"text":"회사는 전방 산업의 수요 회복이 늦어 매출 확보가 부족했고, 그 결과 고정비 부담을 극복하지 못했다고 설명했다.","title":"수요 회복이 늦어 고정비 부담을 넘지 못했다"},{"evidence":[{"k":"q","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"text":"합 계 8,478,901 113,523 8,787,949 119,271"},{"k":"q","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260319000580"},"text":"합 계 1,035,573 63,620 1,175,326 72,136"},{"k":"q","src":{"date":"20260319","id":"S1","title":"사업보고서 (2025.12)","url":"http