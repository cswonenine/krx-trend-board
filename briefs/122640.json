art.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"1,133억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"+67.6%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"134억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"-27억원"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"16.5%"}],"text":"3분기까지 누적 매출은 1,133억원으로 67.6% 늘었다. 누적 순이익은 134억원으로, 전년 같은 기간 -27억원에서 흑자로 돌아섰다. 누적 영업이익률은 16.5%다.","title":"3분기 누적"}]},"name":"예스티","pack_built":"2026-11-28T06:15:12","sources":[{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"1,133억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"+67.6%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"186억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261111","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"value":"+201.5%"}],"text":"2026년 3분기까지 누적 매출은 1,133억원으로 전년 같은 기간보다 67.6% 늘었다. 누적 영업이익은 186억원으로 201.5% 늘었다.","title":"2026년 3분기 누적 실적이 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"가압 Cure 반도체 후공정 HBM 언더필 공정에 활용 (보이드 제거 및 경화)"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"반도체 고압 어닐링 장비 반도체 전공정 고압수소(중수소) 열처리를 통해 계면상의 결함을 치유"}],"text":"회사의 가압 Cure 장비는 반도체 후공정에서 HBM 언더필 공정에 쓰인다. 고압 어닐링 장비는 반도체 전공정에서 고압수소(중수소) 열처리로 계면 결함을 치유하는 데 쓰인다.","title":"HBM 공정 등 반도체 장비 제품군을 갖췄다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"현금및현금성자산 223억원, 매출채권 220억 등 443억원을 보유하고 있으며"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"현금성 자산은 전년 대비 106.3% 증가하였습니다"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"유동비율( C=A/B) 142.0 133.7"}],"text":"2025년 말 현금및현금성자산은 223억원으로 전년보다 106.3% 늘었다. 유동비율은 142.0%로 전기 133.7%보다 높아졌다.","title":"현금성 자산이 106.3% 늘었다"}],"ticker":"122640","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"반도체산업이 투자감소, 디스플레이 산업의 투자이연, 전방산업 주요 고객의 설비투자 감소 등으로 장비부문 매출이 감소함에 따라 전년 대비 13.0% 감소한 871억을 기록하였고"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"영업이익은 38억 기록하였으며, 당기순이익은 7억을 기록하였습니다"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"value":"4.4%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"value":"11.3%"}],"text":"2025년 연결 매출은 871억원으로 13.0% 줄었다. 영업이익은 38억원, 순이익은 7억원에 그쳤다. 영업이익률은 4.4%로 전년 11.3%보다 낮아졌다. 회사는 반도체 투자 감소, 디스플레이 투자 이연, 주요 고객의 설비투자 감소를 이유로 들었다.","title":"2025년 매출이 13.0% 줄고 이익이 크게 줄었다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"value":"-74억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"value":"85억원"}],"text":"2025년 영업현금흐름은 -74억원이었다. 2024년에는 85억원이었다.","title":"2025년 영업현금흐름이 마이너스였다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"부채비율(G=D/E) 66.5 62.5"},{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"소계 23,300,000 6,300,000"}],"text":"2025년 말 부채비율은 66.5%로 전기 62.5%보다 높아졌다. 단기차입금은 23,300,000천원으로 전기말 6,300,000천원보다 늘었다.","title":"부채비율과 단기차입금이 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"당사의 주요 제품은 삼성전자 반도체 생산공정과 삼성디스플레이의 FPD 패널 생산공정에 투입되는"}],"note":"해석: 특정 고객의 설비투자 계획에 따라 매출이 크게 흔들릴 수 있습니다. 회사는 2025년 매출 감소의 이유로도 고객 설비투자 감소를 들었습니다.","text":"회사는 주요 제품이 삼성전자 반도체 생산공정과 삼성디스플레이 FPD 패널 생산공정에 투입된다고 밝혔다.","title":"주요 수요처가 정해져 있다"},{"evidence":[{"k":"q","src":{"date":"20260317","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"text":"고객의 요구사항에 따른 주문생산 장비인 관계로 장비사양에 따라서 판매가격의 차이가 발생하기 때문에 가격변동 추이를 예측하기 어렵습니다"}],"text":"장비는 고객 주문에 따라 사양을 맞춰 만든다. 이 때문에 회사는 가격변동 추이를 예측하기 어렵다고 밝혔다.","title":"주문생산이라 가격을 예측하기 어렵다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":871,"op":38,"net":7,"margin":4.4,"rev_growth":-13.0,"op_growth":-66.3,"debt":66.5,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260317000873"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":438,"op":110,"rev_yoy":134.2,"op_yoy":887.4,"margin":25.1,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261111000039"},"consensus":{"period":"2026.3Q","rev_s":0.0631,"op_s":0.1111,"small":false,"date":"2026-11-11","prelim":false}}}