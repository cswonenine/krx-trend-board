r/dsaf001/main.do?rcpNo=20260323000858"},"text":"단기금융상품 22,000 16,000 6,000 37.50%"}],"text":"2025년 말 별도 기준 부채/자본 비율은 13.5%, 유동비율은 2342.7%다. 단기금융상품은 22,000백만원으로 전년 16,000백만원보다 늘었다.","title":"부채가 적고 유동성이 높다"}],"ticker":"455900","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"-103억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"-108억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"-221.4%"}],"text":"2025년 별도 영업이익은 -103억원으로 2024년 -108억원과 비슷한 적자였다. 영업이익률은 -221.4%다.","title":"영업적자가 크게 이어진다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"-72억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"-72억원"},{"k":"q","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"text":"현금및현금성자산 3,151 15,064 -11,913 -79.08%"},{"computed":false,"k":"f","label":"자본총계 · 2025년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"326억원"},{"computed":false,"k":"f","label":"자본총계 · 2024년","src":{"date":"20260323","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000858"},"value":"403억원"}],"note":"같은 기간 단기금융상품이 늘어 현금 감소의 일부는 자금 운용처를 옮긴 영향으로 보입니다(해석).