ths":[{"evidence":[{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"영업이익(손실) 4,991,149 2,656,039 2,335,110 87.9"},{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"판매비와관리비 11,753,304 15,199,278 (3,445,975) (22.7)"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"50억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"4.4%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"2.1%"}],"note":"해석: 매출이 줄었는데도 영업이익이 늘어난 데에는 판매비와관리비 감소가 영향을 준 것으로 보입니다.","text":"2025년 연결 영업이익은 50억원으로 87.9% 늘었다. 영업이익률은 4.4%로 2024년 2.1%보다 높아졌다. 같은 기간 판매비와관리비는 22.7% 줄었다.","title":"2025년 영업이익이 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"부채총계는 19,209백만원으로 전기 대비 31.5% 감소하였으며, 이는 단기차입금 상환에 따른 유동부채 감소가 주요 원인입니다"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"25.1%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"31.5%"}],"text":"2025년 말 연결 부채총계는 19,209백만원으로 31.5% 줄었다. 회사는 단기차입금 상환을 주된 이유로 들었다. 부채/자본 비율은 25.1%로 전년 31.5%보다 낮아졌다.","title":"부채가 줄었다"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"},"value":"895억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"},"value":"+9.3%"}],"text":"2026년 3분기 누적 매출은 895억원으로 전년 같은 기간보다 9.3% 늘었다.","title":"2026년 들어 매출이 다시 늘고 있다"}],"ticker":"016790","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"1,130억원"},{"computed":false,"k":"f","label":"매출 · 2024년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"1,285억원"},{"computed":false,"k":"f","label":"매출 · 2023년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"1,606억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"-12.0%"},{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"내수 81,429 94,914 117,462"},{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"양계 내수 467.07 492.10 557.28"}],"text":"2025년 연결 매출은 1,130억원으로 12.0% 줄었다. 2023년 1,606억원, 2024년 1,285억원에 이어 감소가 계속됐다. 주력인 양계사료 매출은 81,429백만원으로 2024년 94,914백만원, 2023년 117,462백만원보다 줄었다. 양계사료 kg당 내수 가격도 467.07원으로 2024년 492.10원보다 낮아졌다.","title":"2025년까지 매출이 계속 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"당기순이익(손실) 4,384,187 28,440,598 (24,056,410) (84.6)"},{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"중단영업당기순이익(손실) - 26,165,598 (26,165,598) (100.0)"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"44억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"value":"284억원"}],"note":"해석: 2024년에는 중단영업에서 생긴 이익이 컸기 때문에, 순이익 감소는 주로 그 기저 효과로 보입니다.","text":"2025년 연결 순이익은 44억원으로 84.6% 줄었다. 2024년 순이익 284억원에는 중단영업이익 26,165,598천원이 들어 있었다.","title":"2025년 순이익이 크게 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"자본총계는 76,549백만원으로 전기 대비 13.9% 감소하였으며, 이는 기타포괄손익누계액 감소 영향이 반영된 결과입니다"},{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"이익잉여금(결손금) (432,359,077) (436,743,264) 4,384,187 (1.00)"}],"text":"2025년 말 연결 자본총계는 76,549백만원으로 13.9% 줄었다. 회사는 기타포괄손익누계액 감소를 이유로 들었다. 이익잉여금 자리에는 결손금 432,359,077천원이 남아 있다.","title":"자본이 줄었고 결손금이 크다"},{"evidence":[{"k":"q","src":{"date":"20260324","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"text":"주요 원재료인 옥수수, 대두박 등 대부분의 물량을 수입에 의존하고 있습니다. 이에 따라 배합사료의 가격은 국제곡물가격 및 환율 변동의 영향을 받고 있습니다"}],"text":"회사는 주요 원재료인 옥수수와 대두박의 대부분을 수입한다. 그래서 배합사료 가격이 국제곡물가격과 환율 변동의 영향을 받는다고 밝혔다.","title":"원재료를 수입에 의존해 곡물가격과 환율의 영향을 받는다"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"},"value":"5억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"},"value":"33억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"},"value":"-85.9%"}],"text":"2026년 3분기 누적 영업이익은 5억원으로 전년 같은 기간의 33억원보다 85.9% 줄었다.","title":"2026년 누적 영업이익이 크게 줄었다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":1130,"op":50,"net":44,"margin":4.4,"rev_growth":-12.0,"op_growth":87.9,"debt":25.1,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260324000011"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":299,"op":-2,"rev_yoy":10.6,"op_yoy":"적자전환","margin":-0.7,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001027"}}}