.fss.or.kr/dsaf001/main.do?rcpNo=20261113001140"},"value":"4,025억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 해당 분기","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113001140"},"value":"-45.2%"}],"text":"2025년 계속영업순이익은 1,819십억원으로 전년 1,932십억원보다 줄었고, 순이익률은 15.1%로 2024년 18.0%보다 낮다. 2026년 3분기 연결 순이익도 4,025억원으로 전년 같은 분기보다 45.2% 줄었다.","title":"순이익이 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"text":"서치플랫폼 4,168,936 34.6 3,946,166 36.8"},{"computed":false,"k":"f","label":"유형자산 취득 · 2025년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"value":"1.2조원"},{"computed":false,"k":"f","label":"유형자산 취득 · 2024년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"value":"5,540억원"}],"text":"서치플랫폼 비중은 36.8%에서 34.6%로 낮아졌다. 2025년 설비투자는 1.2조원으로 전년 5,540억원의 두 배를 넘었다.","title":"핵심 검색·광고 비중이 낮아지고 투자가 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"text":"자산총계 41,084 38,168 2,916"},{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"text":"관계기업 및 공동기업 투자 16,649 17,406 (757)"}],"note":"구체적으로 어떤 회사들인지는 이 자료에서 읽지 않았습니다.","text":"총자산 41,084십억원 중 관계기업 및 공동기업 투자가 16,649십억원이다. 이 자산의 가치 변동이 연결 이익과 자본에 영향을 줄 수 있다.","title":"관계기업 투자가 자산의 큰 부분이다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":120350,"op":22081,"net":18187,"margin":18.3,"rev_growth":12.1,"op_growth":11.6,"debt":41.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001021"},"quarter":{"period":"2026-09","kind":"잠정실적","rev":19720,"op":3226,"rev_yoy":7.7,"op_yoy":-40.2,"rev_qoq":2.