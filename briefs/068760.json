ain.do?rcpNo=20261116001031"},"value":"12.5%"}],"text":"3분기 영업이익률은 14.8%로 2025년 연간 10.5%보다 높다. 누적 영업이익률은 12.5%다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"4,473억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"+17.1%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"402억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"+34.6%"}],"text":"3분기 누적 매출은 4,473억원으로 17.1% 늘었고, 순이익은 402억원으로 34.6% 늘었다.","title":"3분기 누적"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"561억원"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"561억원"}],"text":"3분기 누적 영업이익은 561억원으로 2025년 연간 영업이익 561억원과 같은 수준이다.","title":"누적 영업이익이 이미 전년 연간 수준"}]},"name":"셀트리온제약","pack_built":"2026-11-27T11:08:31","sources":[{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"5,364억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"+12.3%"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"영업이익 56,091,784,420 37,222,949,682 18,868,834,738 50.7"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"영업이익률(%p) 10.46 7.79 2.67"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"561억원"}],"text":"2025년 매출은 5,364억원으로 12.3% 늘었다. 영업이익은 561억원으로 50.7% 늘었고, 영업이익률은 10.46%로 전년 7.79%보다 높아졌다.","title":"2025년 매출과 영업이익이 함께 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"간장용제고덱스 포함 케미컬의약품이 2,006억 원의 매출을 기록하며 전기 대비 약 7.8% 성장하였으며, 램시마 등 바이오의약품 매출은 약 1,306억 원을 기록, 전기 대비 약 50.8% 성장하였습니다"}],"text":"램시마 등 바이오의약품 매출은 2025년 약 1,306억원으로 전년보다 약 50.8% 늘었다. 케미컬의약품 매출도 2,006억원으로 약 7.8% 늘었다.","title":"바이오의약품 판매가 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"미국 cGMP 및 유럽 EU-GMP 적격업체로"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"회사는 PFS 생산라인에 대한 미국, 유럽 등 다국적GMP인증을 획득함으로써 케미컬의약품과 바이오의약품의 글로벌 수요에 대응할 수 있는 생산능력을 갖추고 있습니다"}],"text":"회사는 KGMP, 미국 cGMP, 유럽 EU-GMP 적격업체이고, PFS 생산라인도 미국·유럽 등 다국적 GMP 인증을 받아 글로벌 수요에 대응할 생산능력을 갖췄다고 밝혔다.","title":"미국·유럽 GMP 인증 생산시설을 갖췄다"},{"evidence":[{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"864억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"566억원"}],"note":"핵심 숫자 표의 영업현금흐름 값을 썼습니다.","text":"2025년 영업현금흐름은 864억원으로 2024년 566억원보다 많았다.","title":"영업현금흐름이 늘었다"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"561억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"},"value":"+32.4%"}],"text":"2026년 3분기 누적 영업이익은 561억원으로 전년 같은 기간보다 32.4% 늘었다.","title":"2026년 3분기 누적 이익이 크게 늘었다"}],"ticker":"068760","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"모회사인 (주)셀트리온이 개발한 바이오의약품의 국내 독점판매권을 보유하여"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"상품 소계 211,495 39.4"}],"note":"해석: 상품 매출은 모회사 제품의 판매권에 기대고 있어 판매권 조건이 바뀌면 영향이 클 수 있습니다.","text":"회사는 모회사 (주)셀트리온이 개발한 바이오의약품의 국내 독점판매권으로 램시마, 트룩시마, 허쥬마 등을 판다. 2025년 상품 매출은 211,495백만원으로 전체의 39.4%였다.","title":"모회사 제품의 국내 판매 비중이 크다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"부채총계 323,477,395,208 272,540,920,812 50,936,474,396 18.7"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"74.2%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"value":"68.7%"}],"text":"2025년 말 부채총계는 전년보다 18.7% 늘었다. 부채/자본 비율은 74.2%로 전년 68.7%보다 높아졌다.","title":"부채가 자본보다 빠르게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"매출채권 220,286,730,690 212,935,969,654"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"재고자산 122,935,595,604 101,391,753,567"}],"note":"해석: 매출채권이 매출에 비해 크면 현금 회수에 시간이 걸릴 수 있습니다.","text":"2025년 말 매출채권은 220,286,730,690원으로 전년 212,935,969,654원보다 늘었다. 재고자산도 122,935,595,604원으로 전년 101,391,753,567원보다 늘었다.","title":"매출채권과 재고자산이 많다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"text":"제품 고덱스 간장용제 68,431 12.8 66,817 14.0 69,115 17.8"}],"text":"고덱스 내수 매출은 2025년 68,431백만원이다. 전체 매출에서 차지하는 비중은 17.8%, 14.0%, 12.8% 순으로 낮아졌다.","title":"대표 제품 고덱스의 매출 비중이 줄고 있다"}],"key":{"annual":{"year":2025,"basis":"별도","rev":5364,"op":561,"net":388,"margin":10.5,"rev_growth":12.3,"op_growth":50.7,"debt":74.2,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001332"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":1619,"op":239,"rev_yoy":17.2,"op_yoy":48.4,"margin":14.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001031"}}}