.or.kr/dsaf001/main.do?rcpNo=20261116001442"}],"strengths":[{"evidence":[{"computed":false,"k":"f","label":"매출 · 2025년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"1,641억원"},{"computed":true,"k":"f","label":"매출 증가율 · 2025년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"+37.1%"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"101억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"-407억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"6.2%"}],"text":"2025년 연결 매출은 1,641억원으로 37.1% 늘었다. 영업이익은 101억원으로 2024년 -407억원에서 흑자로 돌아섰다. 영업이익률은 6.2%였다.","title":"2025년 매출이 늘고 영업이익이 흑자로 돌아섰다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"수 출 126,733 91,017 104,414"}],"text":"2025년 제품(임플란트) 수출은 126,733백만원으로 2024년 91,017백만원보다 늘었다.","title":"임플란트 수출이 매출을 이끈다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"(1)현금및현금성자산 42,504,199 24,879,460 17,624,739 70.84%"}],"text":"2025년 말 현금및현금성자산은 42,504,199천원으로 2024년 말 24,879,460천원보다 70.84% 늘었다.","title":"현금이 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"UFIII 임플란트, 유니콘 임플란트, 디오나비, Cementless 보철시스템, Full Arch 솔루션 등 당사의 중장기 성장 전략 제품을 중심으로 제품 포트폴리오를 고도화하고, 학술 세미나 및 교육 프로그램 확대를 통해 신규 유저 기반을 점진적으로 확대하는 데 주력하였습니다"}],"text":"회사는 2025년에 UFIII 임플란트, 유니콘 임플란트, 디오나비, Cementless 보철시스템, Full Arch 솔루션 등 중장기 성장 전략 제품을 중심으로 제품 포트폴리오를 고도화하고 학술 세미나와 교육 프로그램으로 신규 유저를 늘리는 데 주력했다고 밝혔다.","title":"전략 제품 중심으로 제품군을 넓히고 있다"}],"ticker":"039840","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"value":"-14억원"},{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"ROE -0.71%"},{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"이익잉여금 59,851,683 77,979,962 (18,128,279) -23.25%"}],"text":"2025년 순이익은 -14억원으로 적자가 이어졌고 ROE는 -0.71%였다. 이익잉여금은 59,851,683천원으로 전년 77,979,962천원보다 23.25% 줄었다.","title":"2025년에도 순손실이 났다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"자기자본비율 58.36% 59.45% (1.09%) -1.84% 부채비율 71.36% 68.21% 3.15% 4.63%"},{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"자사주 신탁을 통한 자기주식 100억원 취득"}],"text":"2025년 말 부채비율은 71.36%로 전년 68.21%보다 높아졌고 자기자본비율은 58.36%로 전년 59.45%보다 낮아졌다. 자산 감소의 주요 요인으로 회사는 자사주 신탁을 통한 자기주식 100억원 취득 등을 들었다.","title":"부채비율이 올랐다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"내 수 16,578 16,777 33,626"}],"text":"제품(임플란트) 내수 매출은 2025년 16,578백만원으로 2024년 16,777백만원과 비슷했고 2023년 33,626백만원보다 크게 낮다.","title":"국내 제품 매출이 2023년보다 크게 낮다"},{"evidence":[{"k":"q","src":{"date":"20260306","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"text":"티타늄의 가격은 205,984원/kg 수준으로 전년대비 18.5% 상승하였으며"}],"note":"해석: 회사는 임플란트의 제조원가 비중이 낮아 가격 변동 요인이 미미하다고 밝히고 있어, 원재료 가격 상승의 영향은 제한적일 수 있습니다.","text":"2025년 임플란트의 주요 원재료인 티타늄 가격은 205,984원/kg 수준으로 전년보다 18.5% 올랐다.","title":"원재료 티타늄 가격이 올랐다"},{"evidence":[{"computed":false,"k":"f","label":"순이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001442"},"value":"-213억원"},{"computed":false,"k":"f","label":"순이익 · 전년 동기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001442"},"value":"59억원"},{"computed":false,"k":"f","label":"영업이익 · 해당 분기 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001442"},"value":"21억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001442"},"value":"-49.8%"}],"text":"2026년 3분기 순이익은 -213억원으로 전년 같은 분기 59억원에서 적자로 돌아섰다. 3분기 영업이익도 21억원으로 49.8% 줄었다.","title":"2026년 3분기 큰 순손실이 났다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":1641,"op":101,"net":-14,"margin":6.2,"rev_growth":37.1,"op_growth":"흑자전환","debt":71.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260306000812"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":383,"op":21,"rev_yoy":-7.6,"op_yoy":-49.8,"margin":5.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001442"},"consensus":{"period":"2026.3Q","rev_s":-0.0681,"op_s":-0.4324,"small":false,"date":"2026-11-16","prelim":false}}}