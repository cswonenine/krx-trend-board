idence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"스프링 소재시장에서 열간압연제품은 당사가 100%를 점유하며"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"국내의 스프링용 소재 제조업체는 당사가 유일함"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"최근 3년간 점유율의 큰 변화는 없습니다"}],"text":"회사는 스프링 소재시장의 열간압연제품을 100% 점유하고 있다고 밝혔다. 국내 스프링용 소재 제조업체는 이 회사가 유일하며, 최근 3년간 점유율의 큰 변화는 없었다.","title":"국내 스프링 소재 시장에서 독보적 지위"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"2025년 매출은 전년 동기 대비 4.58% 증가한 359,287백만원이며"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"합 계 수출 108,659 179,387 91,465 156,432 83,348 151,240"}],"note":"해석: 회사는 일본 스프링 제조업체를 비롯해 여러 지역으로 공급을 넓히고 있다고 밝혀, 수출 확대가 매출 증가를 이끈 것으로 보입니다.","text":"2025년 매출은 359,287백만원으로 4.58% 늘었다. 수출 매출은 179,387백만원으로 2024년 156,432백만원보다 늘었다.","title":"수출이 늘어 2025년 매출이 4.58% 늘었다"},{"evidence":[{"computed":false,"k":"f","label":"자본총계 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"2,587억원"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"18.9%"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"333억원"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"192억원"},{"computed":false,"k":"f","label":"유형자산 취득 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"178억원"}],"text":"2025년 말 자본은 2,587억원, 부채/자본 비율은 18.9%다. 2025년 영업현금흐름은 333억원으로 2024년 192억원보다 늘었고, 설비투자는 178억원이었다.","title":"부채가 적고 영업현금흐름이 늘었다"}],"ticker":"023000","weaknesses":[{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 2023년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"165억원"},{"computed":false,"k":"f","label":"영업이익 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"118억원"},{"computed":false,"k":"f","label":"영업이익 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"99억원"},{"computed":true,"k":"f","label":"영업이익률 · 2023년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"4.6%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"3.4%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"2.7%"}],"text":"영업이익은 2023년 165억원, 2024년 118억원, 2025년 99억원으로 줄었다. 영업이익률도 4.6%, 3.4%, 2.7%로 낮아졌다.","title":"영업이익률이 3년째 낮아지고 있다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"당기순이익은 전년 동기 대비 19.19% 감소한 10,702백만원을 실현하였습니다"}],"text":"2025년 당기순이익은 10,702백만원으로 19.19% 줄었다.","title":"2025년 순이익이 19.19% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"내수 84,509 179,900 86,967 187,127 92,592 207,818"}],"text":"내수 매출은 2023년 207,818백만원, 2024년 187,127백만원, 2025년 179,900백만원으로 줄었다.","title":"내수 매출이 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"2025년말 회사의 부채총계는 489억원으로 전년 대비 88억원(21.83%)이 증가하였습니다"},{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"유동부채는 매입채무가 증가하여"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"16.0%"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"value":"18.9%"}],"text":"2025년 말 부채총계는 489억원으로 21.83% 늘었고, 회사는 매입채무 증가를 이유로 들었다. 부채/자본 비율은 16.0%에서 18.9%로 높아졌다.","title":"부채가 21.83% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260316","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"text":"전방 산업의 수요 둔화와 함께, 전기차(EV) 시장의 '캐즘(Chasm)' 현상에 따른 일시적 수요 정체 및 가격 경쟁력을 앞세운 중국 업체들의 공세로 인해 그 어느 때보다 가혹한 '복합 위기' 상황에 직면해 있습니다"}],"text":"회사는 전방 산업의 수요 둔화, 전기차 시장의 일시적 수요 정체, 가격 경쟁력을 앞세운 중국 업체들의 공세로 '복합 위기'에 직면해 있다고 밝혔다.","title":"수요 둔화와 중국 업체 공세"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001307"},"value":"68억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001307"},"value":"-17.7%"}],"text":"2026년 3분기 누적 영업이익은 68억원으로 전년 같은 기간보다 17.7% 줄었다.","title":"2026년 3분기 누적 영업이익이 줄었다"}],"key":{"annual":{"year":2025,"basis":"별도","rev":3593,"op":99,"net":107,"margin":2.7,"rev_growth":4.6,"op_growth":-16.0,"debt":18.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260316001210"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":868,"op":17,"rev_yoy":-6.9,"op_yoy":-58.8,"margin":2.0,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001307"}}}