n.do?rcpNo=20260318000462"},"value":"1.5%"}],"text":"3분기 영업이익률은 -1.1%였다. 3분기 누적 영업이익률은 3.0%로 2025년 연간 1.5%보다 높다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"4,705억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"+0.9%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"139억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"+135.6%"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"58억원"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"-17.5%"}],"text":"3분기 누적 매출은 4,705억원으로 0.9% 늘었고, 누적 영업이익은 139억원으로 135.6% 늘었다. 반면 누적 순이익은 58억원으로 17.5% 줄었다.","title":"3분기 누적"}]},"name":"에스피삼화","pack_built":"2026-11-27T12:05:37","sources":[{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"}],"strengths":[{"evidence":[{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"82.3%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"87.9%"}],"text":"2025년 말 자본 대비 부채 비율은 82.3%로, 전년 87.9%보다 낮아졌다.","title":"부채 부담이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"매출원가 477,887 504,445 498,952 매출총이익 139,181 123,903 132,430"}],"note":"해석: 회사는 대체원료 개발과 비용 관리로 원가를 줄이고 있다고 밝혔지만, 매출총이익 증가와의 직접 관계는 공시에서 설명되지 않았습니다.","text":"2025년 매출은 줄었지만 매출원가가 477,887백만원으로 2024년 504,445백만원보다 줄어, 매출총이익은 139,181백만원으로 2024년 123,903백만원보다 늘었다.","title":"2025년 매출총이익은 늘었다"},{"evidence":[{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"139억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"59억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"},"value":"+135.6%"}],"text":"2026년 3분기 누적 영업이익은 139억원으로, 전년 같은 기간 59억원보다 135.6% 늘었다.","title":"2026년 3분기 누적 영업이익이 전년보다 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"중국, 베트남, 인도 등의 해외 현지 법인을 통해 글로벌 시장 진출을 확대하고 있으며"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"강화된 정부 규제에 적합하면서도 기존 도료보다 부가 기능이 추가된 도료를 꾸준히 개발하고 있습니다"}],"text":"회사는 중국, 베트남, 인도 등의 해외 현지 법인을 통해 글로벌 시장 진출을 넓히고 있으며, 친환경 규제에 맞으면서 부가 기능을 더한 도료를 꾸준히 개발하고 있다고 밝혔다.","title":"해외 법인과 친환경 도료로 사업을 넓히고 있다"}],"ticker":"000390","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"연결영업이익은 고환율 기조의 장기화 등의 영향으로 비우호적인 경영환경이 조성되어 전기 대비 49.7% 감소한 95억원을 기록하였습니다"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"1.5%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"3.0%"}],"text":"2025년 연결 영업이익은 95억원으로 전년보다 49.7% 줄었고, 영업이익률은 1.5%로 전년 3.0%보다 낮아졌다. 회사는 고환율 기조의 장기화 등을 이유로 들었다.","title":"2025년 영업이익이 49.7% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"관리비 93,290 68,729 67,846"}],"note":"해석: 매출총이익이 늘었는데도 영업이익이 줄어든 데는 관리비 증가가 크게 작용한 것으로 보입니다. 이번 증거에는 관리비가 늘어난 이유에 대한 회사 설명이 없습니다.","text":"2025년 관리비는 93,290백만원으로 2024년 68,729백만원보다 늘었다.","title":"관리비가 크게 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"전기 대비 1.8% 감소한 6,171억원을 기록하였고"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"건설 경기 회복이 지연되며 도료 산업 전반에 수요가 위축되는 등 하방 압력이 이어지고 있습니다"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"78억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"value":"155억원"}],"text":"2025년 연결 매출은 6,171억원으로 전년보다 1.8% 줄었고, 순이익은 78억원으로 2024년 155억원보다 줄었다. 회사는 건설 경기 회복이 늦어지며 도료 산업 전반의 수요가 위축됐다고 밝혔다.","title":"건설 경기 부진으로 매출과 순이익이 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"고환율 지속에 따른 수입 원재료 비용 상승과 내수 시장 위축이 불가피할 것으로 예상되며"},{"k":"q","src":{"date":"20260318","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"text":"원재료 가격의 변동성은 상당 기간 지속될 것으로 우려됩니다"}],"text":"회사는 고환율이 이어지면 수입 원재료 비용이 오르고 내수 시장이 위축될 것으로 예상하며, 원재료 가격의 변동성이 상당 기간 이어질 것을 우려했다.","title":"원재료 가격과 환율 변동 위험"}],"key":{"annual":{"year":2025,"basis":"연결","rev":6171,"op":95,"net":78,"margin":1.5,"rev_growth":-1.8,"op_growth":-49.7,"debt":82.3,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260318000462"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":1487,"op":-16,"rev_yoy":-4.4,"op_yoy":"적자전환","margin":-1.1,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000476"}}}