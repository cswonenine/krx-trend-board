 움직이면 USD에서 손익이 199,317천원 바뀐다고 회사는 밝혔다.","title":"환율 변동에 노출돼 있다"}],"key":{"annual":{"year":2025,"basis":"연결","rev":418,"op":22,"net":20,"margin":5.3,"rev_growth":31.6,"op_growth":1028.1,"debt":52.4,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260323000819"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":148,"op":14,"rev_yoy":27.5,"op_yoy":58.4,"margin":9.8,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000114"}}}