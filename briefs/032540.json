art.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"47억원"},{"computed":false,"k":"f","label":"영업이익 · 2023년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"63억원"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"3.5%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"5.1%"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"40억원"},{"computed":false,"k":"f","label":"순이익 · 2024년","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"value":"46억원"}],"text":"2025년 영업이익은 33억원으로 2024년 47억원, 2023년 63억원에서 줄었다. 영업이익률은 3.5%로 전년 5.1%보다 낮아졌다. 순이익도 40억원으로 2024년 46억원보다 줄었다.","title":"2025년 영업이익과 이익률이 낮아졌다"},{"evidence":[{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"text":"합계 26,121 27,104 34,512"},{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"text":"수출 884 2,001 2,428"}],"text":"노래반주기 부문 매출은 2025년 26,121백만원이다. 2024년 27,104백만원, 2023년 34,512백만원에서 줄었다. 이 부문 수출은 884백만원으로 2024년 2,001백만원보다 줄었다.","title":"노래반주기 매출이 줄고 있다"},{"evidence":[{"k":"q","src":{"date":"20260313","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260313001177"},"text":"유흥시장의 지속적 침체 등으로 신규 설치 및 교체가 원활하지는 않고 있습니다"}],"text":"회사는 유흥시장 침체 등으로 기존 시장에서 신규 설치와 교체가 원활하지 않다고 밝혔다.","title":"유흥시장 침체로 기존 시장의 교체 수요가 약하다"},{"