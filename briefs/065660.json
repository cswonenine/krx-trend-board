art.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"value":"-32.3%"}],"text":"3분기 영업이익률은 12.6%였다. 3분기 누적으로는 -16.5%로, 2025년 연간 -32.3%보다 손실 폭이 작다.","title":"영업이익률"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"73억원"},{"computed":false,"k":"f","label":"매출 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"55억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"+31.8%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"-12억원"},{"computed":false,"k":"f","label":"영업이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"-20억원"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"-3억원"},{"computed":false,"k":"f","label":"순이익 · 전년 누적 (분기보고서 (2026.09))","src":{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"},"value":"-9억원"}],"text":"3분기 누적 매출은 73억원으로 전년 같은 기간 55억원보다 31.8% 늘었다. 누적 영업손실은 12억원으로 전년 20억원보다 줄었다. 누적 순손실도 3억원으로 전년 9억원보다 줄었다.","title":"3분기 누적"}]},"name":"안트로젠","pack_built":"2026-11-27T12:19:20","sources":[{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},{"date":"20261113","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"}],"strengths":[{"evidence":[{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"value":"0.9%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"유동자산 48,252백만원, 유동부채 618백만원으로 유동비율은 3,042%이며"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"중대한 유동성 이슈는 없습니다"}],"text":"2025년 말 부채/자본 비율은 0.9%였다. 유동자산은 48,252백만원, 유동부채는 618백만원으로 유동비율은 3,042%였다. 회사는 중대한 유동성 이슈가 없다고 밝혔다.","title":"빚이 거의 없고 유동성이 넉넉하다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"매출액은 604백만원 증가한 7,536백만원으로 전년 동기에 비해 9% 증가하였습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"채널 공급 확대 등에 따라 75억원을 달성하였으며"}],"text":"2025년 매출은 7,536백만원으로 604백만원(9%) 늘었다. 회사는 주요 제품 판매와 병·의원 채널 공급 확대를 이유로 들었다.","title":"2025년 매출이 9% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"영업이익(손실) (2,433) (3,750) 1,317 (35%)"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"판매비와관리비 5,097 6,378 (1,281) (20%)"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"value":"-54.1%"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"value":"-32.3%"}],"text":"2025년 영업손실은 2,433백만원으로 전년 3,750백만원보다 줄었다. 판매비와관리비가 6,378백만원에서 5,097백만원으로 줄었다. 영업이익률은 -54.1%에서 -32.3%로 나아졌다.","title":"영업손실이 줄고 있다"}],"ticker":"065660","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"당기순이익(손실) (1,374) (2,293) 919 (40%)"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"IV.이익잉여금(결손금) (11,765) (10,429)"}],"text":"2025년 당기순손실은 1,374백만원으로 전년 2,293백만원보다 줄었지만 적자가 이어졌다. 결손금은 11,765백만원으로 전년 10,429백만원보다 커졌다.","title":"아직 적자 기업이다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"제품 큐피스템줄기세포화장품 등 460 6.1% 512 7.4% 1,142 17.6% 상품 레모둘린 등 7,074 93.9%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"합 계 수출 - - - - 472 7.3%"}],"note":"해석: 회사의 핵심 기술인 줄기세포 치료제보다 도입 상품 판매가 실적을 좌우하는 구조로 보입니다.","text":"2025년 매출의 93.9%가 레모둘린 등 상품이었다. 큐피스템과 줄기세포화장품 등 제품 매출은 460백만원으로 2024년 512백만원, 2023년 1,142백만원에서 계속 줄었다. 2023년에 있던 수출 472백만원은 2024년과 2025년에는 없었다.","title":"매출 대부분이 판권 상품이고 자체 제품 매출은 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"매출원가 4,872 4,305 568 13% 매출총이익 2,664 2,628 36 1%"}],"text":"2025년 매출원가는 4,872백만원으로 13% 늘었다. 매출총이익은 2,664백만원으로 1% 늘어나는 데 그쳤다.","title":"원가가 늘어 매출총이익은 거의 그대로였다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"기타포괄-공정가치금융자산 11,977 42,636 (30,660) (72%)"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"총포괄손익(손실) (27,789) (19,266) (8,523) 44%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"자본총계는 투자자산의 평가손실로 인하여 기타포괄손익누계액이 크게 감소하였으며"}],"text":"기타포괄-공정가치금융자산이 42,636백만원에서 11,977백만원으로 줄었다. 총포괄손실은 27,789백만원이었다. 회사는 투자자산의 평가손실로 기타포괄손익누계액이 크게 감소했다고 밝혔다.","title":"투자자산 평가손실로 자본이 크게 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"공시대상기간 중 자금조달은 제3자배정 유상증자 50억원(운영자금 목적)이며"}],"note":"해석: 영업에서 현금을 벌지 못하는 동안에는 외부 자금 조달이 필요할 수 있습니다.","text":"공시대상기간 중 회사는 운영자금 목적으로 제3자배정 유상증자 50억원을 조달했다.","title":"운영자금을 유상증자로 조달했다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"text":"시장환경 변화, 규제 및 허가 일정, 환율 등 외부 요인에 따라 실적 변동 가능성이 존재합니다"}],"text":"회사는 시장환경 변화, 규제와 허가 일정, 환율 같은 외부 요인에 따라 실적이 변동할 수 있다고 밝혔다.","title":"외부 요인에 따른 실적 변동 위험"}],"key":{"annual":{"year":2025,"basis":"별도","rev":75,"op":-24,"net":-14,"margin":-32.3,"rev_growth":8.7,"op_growth":"적자지속","debt":0.9,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312001339"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":30,"op":4,"rev_yoy":45.3,"op_yoy":"흑자전환","margin":12.6,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113000063"}}}