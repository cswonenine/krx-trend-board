.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"172억원"},{"computed":false,"k":"f","label":"순이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"150억원"},{"computed":false,"k":"f","label":"순이익 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"152억원"}],"text":"3분기 누적 영업이익 185억원은 2025년 연간 영업이익 172억원보다 많고, 누적 순이익 150억원은 2025년 연간 순이익 152억원에 가깝다.","title":"누적 이익이 지난해 연간 수준에 다가섰다"}]},"name":"(주)퓨릿","pack_built":"2026-11-27T12:30:03","sources":[{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"}],"strengths":[{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"매출액은 1,425억원으로 전년대비 16.3% 증가하였으며, 영업이익은 172억원으로 전년대비 23.3% 증가하였습니다"},{"computed":true,"k":"f","label":"영업이익률 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"12.1%"},{"computed":true,"k":"f","label":"영업이익률 · 2024년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"11.4%"}],"text":"2025년 매출은 1,425억원으로 16.3% 늘었고, 영업이익은 172억원으로 23.3% 늘었다. 영업이익률은 12.1%로 2024년 11.4%보다 높아졌다(별도 기준).","title":"2025년 매출과 영업이익이 함께 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"반도체 제품 매출액은 1,085억원으로 전년대비 23.4% 증가하였습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"당사의 주요 고객사의 가동률 또한 상승하였습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"반도체 시장의 소재수요 증대와 더불어 시장점유율 확대를 통하여 견조한 실적을 달성하였습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"반도체용 케미컬 수출 13,525,671 10,062,511 4,585,943"}],"text":"2025년 반도체 제품 매출은 1,085억원으로 23.4% 늘었다. 회사는 주요 고객사의 가동률 상승과 시장점유율 확대를 이유로 들었다. 반도체용 케미컬 수출도 2025년 13,525,671천원으로 2024년 10,062,511천원보다 늘었다.","title":"반도체 제품 매출이 23.4% 늘었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"부채비율 14.2%, 자기자본비율 87.5%, ROE 14.1% 등 견실한 재무구조를 갖추었습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"현금및현금성자산 32,367 20,098 61.0%"},{"computed":false,"k":"f","label":"영업활동현금흐름 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"223억원"}],"text":"2025년 말 부채비율은 14.2%, 자기자본비율은 87.5%, ROE는 14.1%였다. 현금및현금성자산은 32,367백만원으로 전년 20,098백만원보다 61.0% 늘었고, 영업현금흐름은 223억원이었다.","title":"재무구조가 견실하고 현금이 늘었다"},{"evidence":[{"computed":false,"k":"f","label":"매출 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"1,301억원"},{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"+22.5%"},{"computed":false,"k":"f","label":"영업이익 · 누적 (분기보고서 (2026.09))","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"185억원"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"+44.3%"}],"text":"2026년 3분기 누적 매출은 1,301억원으로 22.5% 늘었고, 누적 영업이익은 185억원으로 44.3% 늘었다.","title":"2026년 3분기 누적 영업이익이 44.3% 늘었다"}],"ticker":"445180","weaknesses":[{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"반도체용 케미컬 108,460 76.09%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"당사의 주요 제품은 반도체 제품으로서, 전방산업인 반도체 산업의 영향을 받고 있습니다"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"그 변동에 따라 당사의 영업실적이 영향을 받게됩니다"}],"text":"2025년 매출의 76.09%가 반도체용 케미컬이다. 회사는 주요 제품이 반도체 제품이어서 전방산업인 반도체 산업의 영향을 받고, 그 변동에 따라 영업실적이 영향을 받는다고 밝혔다.","title":"실적이 반도체 산업에 크게 좌우된다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"산업용 19,205 24,453 -21.5%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"산업용 케미컬 19,205 13.47% 24,453 19.96% 29,410 24.42%"}],"note":"해석: 이번 증거에는 산업용 케미컬 매출이 줄어든 이유에 대한 회사 설명이 없습니다.","text":"산업용 케미컬 매출은 2025년 19,205백만원으로 2024년 24,453백만원보다 21.5% 줄었다. 2023년에는 29,410백만원이었다.","title":"산업용 케미컬 매출이 21.5% 줄었다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"디스플레이용 케미컬 4,993 3.50% 2,206 1.80% 18,441 15.31%"},{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"LCD에서 OLED로 시장이 변화하고 있으며, 이로 인해 LCD의 비중은 점차 감소하고 있습니다"}],"note":"해석: LCD 시장 변화가 이 회사의 디스플레이용 매출 변동과 직접 관련됐는지는 공시에서 확인되지 않습니다.","text":"디스플레이용 케미컬 매출은 2023년 18,441백만원에서 2024년 2,206백만원으로 줄었다가 2025년 4,993백만원으로 늘었다. 회사는 LCD에서 OLED로 시장이 바뀌면서 LCD 비중이 점차 줄고 있다고 밝혔다.","title":"디스플레이용 매출은 규모가 작고 변동이 컸다"},{"evidence":[{"k":"q","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"text":"부채총계 15,291 10,634 43.8%"},{"computed":true,"k":"f","label":"부채/자본 · 2025년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"14.2%"},{"computed":true,"k":"f","label":"부채/자본 · 2024년","src":{"date":"20260312","id":"S1","title":"사업보고서 (2025.12)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"value":"11.4%"}],"note":"해석: 부채가 늘었지만 자본에 비해서는 여전히 낮은 수준으로 보입니다.","text":"2025년 말 부채총계는 15,291백만원으로 전년 10,634백만원보다 43.8% 늘었다. 부채/자본 비율은 14.2%로 2024년 11.4%보다 높아졌다.","title":"부채가 43.8% 늘었다"},{"evidence":[{"computed":true,"k":"f","label":"매출 전년 동기 대비 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"+28.4%"},{"computed":true,"k":"f","label":"영업이익 전년 동기 대비 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"+14.9%"},{"computed":true,"k":"f","label":"순이익 전년 동기 대비 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"+8.7%"},{"computed":true,"k":"f","label":"영업이익률 · 해당 분기","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"12.7%"},{"computed":true,"k":"f","label":"영업이익률 · 누적","src":{"date":"20261116","id":"S2","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"value":"14.2%"}],"text":"2026년 3분기 매출은 28.4% 늘었지만 영업이익은 14.9%, 순이익은 8.7% 늘었다. 3분기 영업이익률은 12.7%로 누적 14.2%보다 낮다.","title":"3분기에는 이익 증가가 매출 증가보다 더뎠다"}],"key":{"annual":{"year":2025,"basis":"별도","rev":1425,"op":172,"net":152,"margin":12.1,"rev_growth":16.3,"op_growth":23.3,"debt":14.2,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260312000650"},"quarter":{"period":"2026-09","kind":"분기보고서","rev":474,"op":60,"rev_yoy":28.4,"op_yoy":14.9,"margin":12.7,"url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116000234"},"consensus":{"period":"2026.3Q","rev_s":0.1101,"op_s":0.25,"small":false,"date":"2026-11-16","prelim":false}}}